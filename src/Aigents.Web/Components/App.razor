<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>unrealestate.au — Free Australian property listings</title>
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/auth.css"]" />
    <link rel="stylesheet" href="@Assets["Aigents.Web.styles.css"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <!-- Property Viz Helpers (local-only, no external map/CDN egress) -->
    <script src="js/property-viz.js"></script>
    <script src="js/globe-viz.js"></script>
    <script src="js/syndication-map.js"></script>
    <script src="js/before-after-slider.js"></script>
    <script>
        document.addEventListener('mousemove', (e) => {
            const x = (e.clientX / window.innerWidth - 0.5) * 2;
            const y = (e.clientY / window.innerHeight - 0.5) * 2;
            document.body.style.setProperty('--mouse-x', x);
            document.body.style.setProperty('--mouse-y', y);
        });

        // Self-contained local map helper — renders interactive markers locally
        // with zero external CDN, tile, or GIS requests.
        window.leafletMap = {
            container: null,
            markers: [],
            dotNetRef: null,
            selectedId: null,

            init: function(elementId, lat, lng, zoom, dotNetReference) {
                const el = document.getElementById(elementId);
                if (!el) return false;

                this.container = el;
                this.dotNetRef = dotNetReference;
                this.markers = [];
                this.selectedId = null;

                el.innerHTML = '';
                el.style.position = 'relative';
                el.style.background = 'linear-gradient(180deg, #e2e8f0 0%, #f8fafc 100%)';
                el.style.overflow = 'hidden';

                const canvas = document.createElement('div');
                canvas.className = 'local-map-canvas';
                canvas.style.cssText = 'display:flex;flex-wrap:wrap;gap:10px;padding:16px;align-content:flex-start;width:100%;height:100%;box-sizing:border-box;';
                el.appendChild(canvas);

                el.onclick = (e) => {
                    const marker = e.target.closest('.airbnb-marker');
                    if (marker) {
                        const id = marker.getAttribute('data-id');
                        if (id) this.selectMarker(id);
                    }
                };
                return true;
            },

            addMarker: function(id, lat, lng, price, isSelected) {
                if (!this.container) return;
                const canvas = this.container.querySelector('.local-map-canvas') || this.container;
                const wrapper = document.createElement('div');
                wrapper.className = 'airbnb-marker-wrapper';
                wrapper.innerHTML = `<div class="airbnb-marker ${isSelected ? 'selected' : ''}" data-id="${id}">
                    <span class="marker-price">${price}</span>
                </div>`;
                canvas.appendChild(wrapper);
                this.markers.push({ id, lat, lng, el: wrapper });
                if (isSelected) this.selectedId = id;
            },

            selectMarker: function(id) {
                document.querySelectorAll('.airbnb-marker').forEach(el => el.classList.remove('selected'));
                const selected = document.querySelector(`.airbnb-marker[data-id="${id}"]`);
                if (selected) selected.classList.add('selected');
                this.selectedId = id;
                if (this.dotNetRef) {
                    this.dotNetRef.invokeMethodAsync('OnMarkerClicked', id).catch(() => {});
                }
            },

            clearMarkers: function() {
                if (this.container) {
                    const canvas = this.container.querySelector('.local-map-canvas');
                    if (canvas) canvas.innerHTML = '';
                }
                this.markers = [];
                this.selectedId = null;
            },

            fitBounds: function() {},
            setView: function() {},

            dispose: function() {
                this.dotNetRef = null;
                this.clearMarkers();
                this.container = null;
            }
        };
    </script>
</body>

</html>
