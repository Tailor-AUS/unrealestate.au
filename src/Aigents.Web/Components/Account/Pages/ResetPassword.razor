@page "/Account/ResetPassword"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Aigents.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<User> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Choose a new password | unrealestate.au</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <h1>Choose a new password</h1>
        @if (_errors.Count > 0)
        {
            <div class="auth-error"><ul>@foreach (var e in _errors) { <li>@e</li> }</ul></div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="DoReset" FormName="reset">
            <DataAnnotationsValidator />
            <input type="hidden" name="UserId" value="@UserId" />
            <input type="hidden" name="Code" value="@Code" />

            <div class="auth-field">
                <label for="password">New password</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" />
                <small>Min 10 characters with upper, lower, and a number.</small>
                <ValidationMessage For="() => Input.Password" />
            </div>
            <div class="auth-field">
                <label for="confirm">Confirm password</label>
                <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>
            <button type="submit" class="auth-cta">Save password</button>
        </EditForm>
    </div>
</section>

@code {
    private readonly List<string> _errors = new();

    [SupplyParameterFromForm] public InputModel Input { get; set; } = new();
    [SupplyParameterFromQuery] public Guid? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    private async Task DoReset()
    {
        _errors.Clear();
        if (UserId is null || string.IsNullOrEmpty(Code))
        {
            _errors.Add("This reset link is incomplete or expired. Request a new one from the Forgot Password page.");
            return;
        }
        var user = await UserManager.FindByIdAsync(UserId.Value.ToString());
        if (user is null)
        {
            _errors.Add("We couldn't find an account for this reset link.");
            return;
        }
        var token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }
        RedirectManager.RedirectTo("/Account/Login");
    }

    public sealed class InputModel
    {
        [Required, StringLength(100, MinimumLength = 10), DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;
        [Required, Compare(nameof(Password)), DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
