        new Agent(Guid.Parse("66666666-6666-6666-6666-666666666666"),
            "Daniel Wright", "DW", "Coronis", "Moorooka QLD", "#0ea5e9",
            SoldThisYear: 19, AvgDays: 21, OverAskPct: 7, ActivePipeline: 8,
            AvgBuyersPerSale: 17, IsBaby: false,
            RecentComps: new []
            {
                new Comp("3 Victoria Tce, Moorooka", "$1.07M", 4, "1 week ago"),
                new Comp("25 Beaudesert Rd, Moorooka","$0.94M",3, "6 weeks ago"),
                new Comp("14 Marshall Rd, Moorooka", "$1.21M", 4, "11 weeks ago")
            })
    };

    private string _selectedMode = "open";
    private Guid? _proposalAgentId;
    private double _commission = 2.2;
    private int _marketing = 1500;
    private int _weeks = 6;
    private string _strategy = "private";
    private string _notes = "";
    private readonly HashSet<Guid> _invited = new();
    private string? _lastSentAgentName;

    private void SelectMode(string key)
    {
        _selectedMode = key;
        _proposalAgentId = null;
    }

    private void OpenProposal(Guid id) => _proposalAgentId = id;
    private void CloseProposal() => _proposalAgentId = null;

    private void ViewAgent(Guid id)
    {
        Nav.NavigateTo($"/agents/listing/{Math.Abs(id.GetHashCode() % 9999) + 1}");
    }

    private void SendProposal()
    {
        if (_proposalAgentId is { } id)
        {
            _invited.Add(id);
            _lastSentAgentName = _agents.FirstOrDefault(a => a.Id == id)?.Name;
            _proposalAgentId = null;
        }
    }
}
