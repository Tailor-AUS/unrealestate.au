@page "/agents"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation

<PageTitle>Aigents for Agents — Free, not-for-profit, open source. By Tailor (50k+ users).</PageTitle>

<div class="agent-wrapper">
    @* Interactive ripple background *@
    <canvas id="ripple-canvas-agents" class="ripple-canvas"></canvas>
    <div class="agent-bg"></div>
    
    @* Navigation *@
    <nav class="agent-nav">
        <div class="nav-container">
            <a href="/" class="logo">
                <span class="logo-mark">◆</span>
                <span class="logo-text">aigents</span>
            </a>
            <div class="nav-links">
                <a href="/chat?mode=buy" class="nav-link">For Buyers</a>
                <a href="#how-it-works" class="nav-link">How It Works</a>
                <a href="#pricing" class="nav-link">Pricing</a>
                <button class="nav-cta" @onclick="GoToRegister">Try Free</button>
            </div>
        </div>
    </nav>

    @* Hero Section - Split Layout *@
    <section class="hero-section">
        <div class="hero-grid">
            @* Left Content *@
            <div class="hero-left animate-fade-up">
                <div class="eyebrow">
                    <span class="eyebrow-icon">◆</span>
                    <span>A not-for-profit by Tailor · Open source · No commercial agenda</span>
                </div>

                <h1 class="hero-headline">
                    A$1.7 billion.<br/>
                    Every year.<br/>
                    <span class="headline-gradient">Out of Australia.</span>
                </h1>

                <p class="hero-subheadline">
                    Aigents isn't a SaaS. It's a not-for-profit community project by
                    <strong>Tailor</strong> — the team behind the open Australian fuel-price app
                    already used by <strong>50,000+ Aussies</strong>. Every Australian home sale
                    routes through a US-owned listing portal that charges thousands just to
                    publish photos and a description. News Corp owns realestate.com.au. CoStar
                    (Virginia) bought Domain in August 2025. We got fed up. So we built the
                    open-source alternative.
                </p>

                @* Single primary CTA — agent register *@
                <div class="agent-paths">
                    <div class="agent-path" @onclick="GoToRegister">
                        <div class="path-icon">🇦🇺</div>
                        <div class="path-content">
                            <strong>Try Aigents free</strong>
                            <span>For Australian-licensed real estate agents — Brisbane &amp; Gold Coast first.</span>
                        </div>
                        <span class="path-arrow">→</span>
                    </div>
                </div>

                @* Trust Badges *@
                <div class="trust-badges">
                    <div class="trust-badge">
                        <span class="badge-check">✓</span>
                        <span>Australian-owned</span>
                    </div>
                    <div class="trust-badge">
                        <span class="badge-check">✓</span>
                        <span>Open source</span>
                    </div>
                    <div class="trust-badge">
                        <span class="badge-check">✓</span>
                        <span>No per-listing fees</span>
                    </div>
                </div>
            </div>
            
            @* Right Visual — agent dashboard mockup *@
            <div class="hero-right animate-fade-up delay-2">
                <div class="mockup-container">
                    @* Dashboard Mockup *@
                    <div class="dashboard-mockup">
                        <div class="dashboard-header">
                            <span class="dash-title">Your listings on Aigents</span>
                            <span class="dash-count">3 active · $1.27 in AI</span>
                        </div>

                        <div class="listing-preview">
                            <div class="listing-img-placeholder"></div>
                            <div class="listing-info">
                                <div class="listing-address">42 Ocean View Dr, Byron Bay</div>
                                <div class="listing-meta">5 bed · AI-drafted listing · 0.51¢ in tokens</div>
                                <div class="listing-status">
                                    <span class="status-dot"></span>
                                    14 buyer matches
                                </div>
                            </div>
                        </div>

                        <div class="listing-preview">
                            <div class="listing-img-placeholder alt"></div>
                            <div class="listing-info">
                                <div class="listing-address">18 Teneriffe Dr, Brisbane</div>
                                <div class="listing-meta">3 bed · River views · 0.38¢ in tokens</div>
                                <div class="listing-status hot">
                                    <span class="status-dot"></span>
                                    Pre-approved buyer · Mark D.
                                </div>
                            </div>
                        </div>

                        <div class="listing-preview">
                            <div class="listing-img-placeholder"></div>
                            <div class="listing-info">
                                <div class="listing-address">67 Northview Outlook, Moorooka 4105</div>
                                <div class="listing-meta">4 bed · AI valuation $1.20–1.28M · 0.42¢</div>
                                <div class="listing-status new">
                                    <span class="status-dot"></span>
                                    Listing draft ready
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Floating Badges *@
                    <div class="floating-badge badge-1">
                        <span class="float-icon">🇦🇺</span>
                        <div class="float-text">
                            <strong>Australia East</strong>
                            <span>All inference local</span>
                        </div>
                    </div>
                    <div class="floating-badge badge-2">
                        <span class="float-icon">⚡</span>
                        <div class="float-text">
                            <strong>$1.27</strong>
                            <span>Total AI cost so far</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* Stats band — the photo tax in numbers *@
    <section class="stats-band">
        <div class="stats-container">
            <div class="stats-eyebrow">Why we exist</div>
            <div class="stats-grid">
                <div class="stat-cell">
                    <div class="stat-figure">A$1.7B</div>
                    <div class="stat-label">Leaves Australia every year. Aussies paying foreign portals to advertise Australian homes.</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-figure">100%</div>
                    <div class="stat-label">Of major Australian listing portals are now US-owned (News Corp + CoStar Group).</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-figure">531,457</div>
                    <div class="stat-label">Australian families paid the foreign tax in FY2024-25 to sell their largest asset.</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-figure">0</div>
                    <div class="stat-label">Australian-owned major listing portals as of 27 August 2025.</div>
                </div>
            </div>
            <p class="stats-footnote">
                Sources:
                <a href="https://companiesmarketcap.com/rea-group/revenue/" target="_blank" rel="noopener">REA FY2025 revenue</a> ·
                <a href="https://www.costargroup.com/press-room/2025/costar-group-completes-acquisition-domain-ushering-new-era-innovation-australias" target="_blank" rel="noopener">CoStar acquisition</a> ·
                <a href="https://pages.corelogic.com/hubfs/CoreLogic%20AU/Article%20Reports/2507-Cotality-HousingChartPack-July-Report.pdf" target="_blank" rel="noopener">Cotality FY24-25 sales</a>
            </p>
        </div>
    </section>

    @* How It Works Section *@
    <section class="how-section" id="how-it-works">
        <div class="how-container">
            <h2 class="section-title">How it works for agents</h2>
            <p class="section-subtitle">Drop your photos in. We do the rest.</p>

            <div class="how-steps">
                <div class="how-step">
                    <div class="step-num">01</div>
                    <h3>Upload your photos</h3>
                    <p>Drop in the photos and address. Our AI writes the listing copy, the suburb pitch, the buyer Q&amp;A, and a comparable-sales valuation in under a minute. All inference runs in Azure Australia East.</p>
                </div>
                <div class="how-step">
                    <div class="step-num">02</div>
                    <h3>Buyers come to you</h3>
                    <p>Buyers chatting with the Aigents buyer-side AI get matched to your listing in real time. You see warm leads with budget, pre-approval status, and what they want — no realestate.com.au required.</p>
                </div>
                <div class="how-step">
                    <div class="step-num">03</div>
                    <h3>You close the deal</h3>
                    <p>You stay the agent of record. You keep the relationship and the full commission. We just bill you for the GPT tokens we used on your behalf, plus a flat margin. Cancel anytime.</p>
                </div>
            </div>
        </div>
    </section>

    @* Pricing Section — not-for-profit, you pay AI cost only *@
    <section class="pricing-section" id="pricing">
        <div class="pricing-container">
            <h2 class="section-title">It's free. We're a not-for-profit.</h2>
            <p class="section-subtitle">No subscription. No tiers. No upsell. You pay only what the AI cost us on your behalf — every cent itemised in your dashboard. We don't take a margin. Nothing leaves the country.</p>

            <div class="pricing-cards" style="grid-template-columns: 1fr 1fr; max-width: 880px; margin: 0 auto;">
                <div class="pricing-card featured">
                    <div class="featured-badge">For Australian agents</div>
                    <div class="price-header">
                        <h3>Hosted by Tailor</h3>
                        <div class="price">AI cost<span>only · no margin</span></div>
                    </div>
                    <ul class="price-features">
                        <li>✓ Unlimited AI listings</li>
                        <li>✓ Buyer-side AI matches</li>
                        <li>✓ One-click migration off REA / Domain</li>
                        <li>✓ Live token-cost dashboard (every cent)</li>
                        <li>✓ Inference in Australia East</li>
                        <li>✓ No subscription, no lock-in</li>
                    </ul>
                    <button class="price-cta primary" @onclick="GoToRegister">Use it free</button>
                </div>

                <div class="pricing-card">
                    <div class="price-header">
                        <h3>Self-host</h3>
                        <div class="price">$0<span>· Apache 2.0</span></div>
                    </div>
                    <ul class="price-features">
                        <li>✓ Full source on GitHub</li>
                        <li>✓ Run on your own Azure / Hetzner / bare metal</li>
                        <li>✓ Bring your own AI key</li>
                        <li>✓ Community support</li>
                        <li>✓ No usage limits</li>
                        <li>✓ Fork it, extend it, share it back</li>
                    </ul>
                    <a class="price-cta secondary" href="https://github.com/Tailor-AUS/aigents-dotnet" target="_blank" rel="noopener">View on GitHub</a>
                </div>
            </div>

            <p class="pricing-footnote" style="text-align:center; margin-top:32px; font-size:14px; color:#6b7280; max-width:680px; margin-left:auto; margin-right:auto;">
                Tailor is the team behind the open Australian fuel-price app used by 50,000+
                Aussies to find cheap petrol. Aigents is the same idea applied to real estate
                listings. We're not trying to build a unicorn. We're trying to keep the A$1.7B/yr
                in Australia.
            </p>
        </div>
    </section>

    @* Final CTA *@
    <section class="final-cta">
        <div class="cta-container">
            <h2>Help us keep A$1.7B in Australia.</h2>
            <p>This is a not-for-profit community project. Use it free. Fork it. Tell your agent. Tell your neighbour selling their house. The more of us who refuse to fund the offshore middlemen, the faster the A$1.7B/yr starts staying in Australia.</p>
            <button class="mega-cta" @onclick="GoToRegister">Use it free</button>
        </div>
    </section>
</div>

<style>
/* ═══════════════════════════════════════════════════════════════
   AGENT PORTAL - Premium Design
═══════════════════════════════════════════════════════════════ */

@@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

.agent-wrapper {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #fafafa;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    position: relative;
    overflow-x: hidden;
}

.ripple-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
}

.agent-bg {
    position: fixed;
    inset: 0;
    background: 
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(139, 92, 246, 0.12), transparent),
        radial-gradient(ellipse 60% 50% at 80% 50%, rgba(99, 102, 241, 0.08), transparent);
    pointer-events: none;
    z-index: 0;
}

/* Navigation */
.agent-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(250, 250, 250, 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    text-decoration: none;
}

.logo-mark {
    font-size: 20px;
    color: #8b5cf6;
}

.logo-text {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a2e;
    letter-spacing: -0.02em;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
}

.nav-link {
    font-size: 14px;
    font-weight: 500;
    color: #6b7280;
    text-decoration: none;
    transition: color 0.2s;
}

.nav-link:hover {
    color: #1a1a2e;
}

.nav-cta {
    padding: 10px 20px;
    background: #1a1a2e;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.nav-cta:hover {
    background: #2d2d44;
    transform: translateY(-1px);
}

/* Hero Section */
.hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 24px 60px;
    position: relative;
    z-index: 2;
}

.hero-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.hero-left {
    text-align: left;
}

.eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #8b5cf6;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
}

.eyebrow-icon {
    font-size: 12px;
}

.hero-headline {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #1a1a2e;
    margin-bottom: 20px;
}

.headline-gradient {
    background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientFlow 8s ease infinite;
}

@@keyframes gradientFlow {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 100% center; }
}

.hero-subheadline {
    font-size: 18px;
    line-height: 1.7;
    color: #6b7280;
    margin-bottom: 32px;
    max-width: 480px;
}

/* Agent Path Selection */
.agent-paths {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
}

.agent-path {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: white;
    border: 2px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.agent-path:hover {
    border-color: #8b5cf6;
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.15);
    transform: translateX(4px);
}

.path-icon {
    font-size: 24px;
}

.path-content {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.path-content strong {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a2e;
}

.path-content span {
    font-size: 13px;
    color: #9ca3af;
}

.path-arrow {
    font-size: 18px;
    color: #8b5cf6;
    transition: transform 0.2s;
}

.agent-path:hover .path-arrow {
    transform: translateX(4px);
}

/* Trust Badges */
.trust-badges {
    display: flex;
    gap: 24px;
}

.trust-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: #6b7280;
}

.badge-check {
    color: #8b5cf6;
    font-weight: 600;
}

/* Hero Right - Dashboard Mockup */
.hero-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
}

.mockup-container {
    position: relative;
    width: 100%;
    max-width: 420px;
}

.dashboard-mockup {
    background: white;
    border-radius: 20px;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.12);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 20px;
}

.dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.dash-title {
    font-weight: 700;
    font-size: 18px;
    color: #1a1a2e;
}

.dash-count {
    font-size: 13px;
    color: #8b5cf6;
    font-weight: 600;
    background: rgba(139, 92, 246, 0.1);
    padding: 4px 10px;
    border-radius: 20px;
}

.listing-preview {
    display: flex;
    gap: 14px;
    padding: 14px;
    background: #f8fafc;
    border-radius: 12px;
    margin-bottom: 12px;
    transition: all 0.2s;
}

.listing-preview:hover {
    background: #f1f5f9;
}

.listing-img-placeholder {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
    border-radius: 8px;
    flex-shrink: 0;
}

.listing-img-placeholder.alt {
    background: linear-gradient(135deg, #c4b5fd, #a78bfa);
}

.listing-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.listing-address {
    font-weight: 600;
    font-size: 14px;
    color: #1a1a2e;
    margin-bottom: 4px;
}

.listing-meta {
    font-size: 12px;
    color: #9ca3af;
    margin-bottom: 6px;
}

.listing-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #6b7280;
}

.status-dot {
    width: 6px;
    height: 6px;
    background: #6b7280;
    border-radius: 50%;
}

.listing-status.hot .status-dot {
    background: #f97316;
    animation: pulse 1s infinite;
}

.listing-status.new .status-dot {
    background: #10b981;
}

@@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

/* Floating Badges */
.floating-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    animation: floatBadge 4s ease-in-out infinite;
}

.badge-1 {
    top: 0;
    right: -10px;
    animation-delay: 0s;
}

.badge-2 {
    bottom: 20%;
    left: -20px;
    animation-delay: 2s;
}

@@keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

.float-icon {
    font-size: 20px;
}

.float-text {
    display: flex;
    flex-direction: column;
}

.float-text strong {
    font-size: 13px;
    font-weight: 700;
    color: #1a1a2e;
}

.float-text span {
    font-size: 11px;
    color: #9ca3af;
}

/* How Section */
.how-section {
    padding: 120px 24px;
    background: white;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
}

.how-container {
    max-width: 1000px;
    margin: 0 auto;
}

.section-title {
    font-size: 36px;
    font-weight: 800;
    color: #1a1a2e;
    text-align: center;
    margin-bottom: 12px;
}

.section-subtitle {
    font-size: 18px;
    color: #6b7280;
    text-align: center;
    margin-bottom: 64px;
}

.how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
}

.how-step {
    text-align: left;
}

.step-num {
    font-size: 48px;
    font-weight: 800;
    color: rgba(139, 92, 246, 0.15);
    margin-bottom: 16px;
    line-height: 1;
}

.how-step h3 {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 12px;
}

.how-step p {
    font-size: 15px;
    line-height: 1.6;
    color: #6b7280;
}

/* International Section */
.intl-section {
    padding: 120px 24px;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
}

.intl-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.intl-badge {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
    font-size: 13px;
    font-weight: 600;
    border-radius: 20px;
    margin-bottom: 20px;
}

.intl-content h2 {
    font-size: 36px;
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1.2;
    margin-bottom: 20px;
}

.intl-content p {
    font-size: 17px;
    line-height: 1.7;
    color: #6b7280;
    margin-bottom: 24px;
}

.intl-features {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
}

.intl-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: #1a1a2e;
}

.feature-icon {
    color: #10b981;
    font-weight: 700;
}

.intl-cta {
    padding: 14px 28px;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}

.intl-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 92, 246, 0.35);
}

.intl-visual {
    display: flex;
    justify-content: center;
    align-items: center;
}

.globe-graphic {
    position: relative;
    width: 300px;
    height: 300px;
}

.globe-dot {
