@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    public string? QueryLink { get; set; }

    private Guid? _currentUserId;
    private string _sourceUrl = "";
    private bool _isImporting;
    private bool _isPublishing;
    private bool _draftLoaded;
    private bool _copied;
    private string? _importError;
    private string? _importNotice;

    private string _address = "";
    private string _suburb = "";
    private string _state = "QLD";
    private string _postcode = "";
    private string _propertyType = "House";
    private int? _bedrooms;
    private int? _bathrooms;
    private int? _carSpaces;
    private int? _landSize;
    private decimal? _askingPrice;
    private string _priceDisplay = "";
    private string _headline = "";
    private string _description = "";
    private string? _heroImageUrl;

    private string _agentName = "";
    private string _agentPhone = "";
    private bool _enableVoiceAssistant; // explicit opt-in only
    private bool _confirmAuthorised;

    private Listing? _publishedListing;
    private VoiceAssistantProvisionResult? _voiceResult;

    private int _calcListings = 36;
    private int _calcVpa = 4200;

    private string LoginReturnHref =>
        string.IsNullOrWhiteSpace(_sourceUrl)
            ? "/Account/Login?ReturnUrl=%2Fagents"
            : $"/Account/Login?ReturnUrl={Uri.EscapeDataString($"/agents?link={Uri.EscapeDataString(_sourceUrl)}")}";

    private bool CanPublish =>
        _currentUserId.HasValue
        && _confirmAuthorised
        && !string.IsNullOrWhiteSpace(_address)
        && !string.IsNullOrWhiteSpace(_suburb)
        && !string.IsNullOrWhiteSpace(_postcode)
        && !string.IsNullOrWhiteSpace(_agentName);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var user = state.User;
            if (user.Identity?.IsAuthenticated == true
                && Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var uid))
            {
                _currentUserId = uid;
                _agentName = user.FindFirstValue(ClaimTypes.Name) ?? "";
            }
        }
    }

    protected override void OnParametersSet()
    {
        // Pre-fill the input only — never auto-fetch QueryLink during GET/SSR (prevents reflected SSRF).
        if (!string.IsNullOrWhiteSpace(QueryLink) && string.IsNullOrWhiteSpace(_sourceUrl))
            _sourceUrl = QueryLink;
    }

    private async Task HandleUrlKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _currentUserId.HasValue)
            await ImportFromLinkAsync();
    }

    private async Task ImportFromLinkAsync()
    {
        if (!_currentUserId.HasValue || _isImporting) return;

        _importError = null;
        _importNotice = null;
        _publishedListing = null;
        _voiceResult = null;
        _copied = false;

        if (string.IsNullOrWhiteSpace(_sourceUrl))
        {
            _importError = "Paste your listing link first (e.g. https://youragency.com.au/...).";
            return;
        }

        _isImporting = true;
        StateHasChanged();

        try
        {
            var draft = await LinkImporter.ImportFromUrlAsync(_sourceUrl);
            if (!draft.Succeeded)
            {
                _importError = draft.Notice ?? "Could not validate that URL.";
                return;
            }

            _address = draft.Address ?? "";
            _suburb = draft.Suburb ?? "";
            _state = string.IsNullOrWhiteSpace(draft.State) ? "QLD" : draft.State;
            _postcode = draft.Postcode ?? "";
            _propertyType = string.IsNullOrWhiteSpace(draft.PropertyType) ? "House" : draft.PropertyType;
            _bedrooms = draft.Bedrooms;
            _bathrooms = draft.Bathrooms;
            _carSpaces = draft.CarSpaces;
            _landSize = draft.LandSize;
            _askingPrice = draft.AskingPrice;
            _priceDisplay = draft.PriceDisplay ?? (draft.AskingPrice.HasValue ? $"${draft.AskingPrice.Value:N0}" : "");
            _headline = draft.Headline ?? "";
            _description = draft.Description ?? "";
            _heroImageUrl = draft.HeroImageUrl;
            _importNotice = draft.Notice;
            _draftLoaded = true;
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }

    private async Task PublishImportedListingAsync()
    {
        if (!CanPublish || !_currentUserId.HasValue || _isPublishing) return;

        _isPublishing = true;
        _importError = null;
        StateHasChanged();

        try
        {
            var images = string.IsNullOrWhiteSpace(_heroImageUrl)
                ? "[]"
                : JsonSerializer.Serialize(new[] { _heroImageUrl });

            var fullDescription = string.IsNullOrWhiteSpace(_description)
                ? $"Published via 1-link auto-post from {_sourceUrl}."
                : _description.Trim();

            var features = new List<string> { "Listed $0 on unrealestate.au (Not-for-profit)" };
            if (!string.IsNullOrWhiteSpace(_agentPhone))
                features.Add($"Direct agent contact: {_agentName.Trim()} ({_agentPhone.Trim()})");
            else
                features.Add($"Direct agent contact: {_agentName.Trim()}");

            var listing = new Listing
            {
                Id = Guid.NewGuid(),
                Address = _address.Trim(),
                Suburb = _suburb.Trim(),
                State = _state.Trim().ToUpperInvariant(),
                Postcode = _postcode.Trim(),
                PropertyType = _propertyType,
                Bedrooms = _bedrooms,
                Bathrooms = _bathrooms,
                CarSpaces = _carSpaces,
                LandSize = _landSize,
                AskingPrice = _askingPrice,
                PriceDisplay = string.IsNullOrWhiteSpace(_priceDisplay)
                    ? (_askingPrice.HasValue ? $"${_askingPrice.Value:N0}" : "Contact Agent")
                    : _priceDisplay.Trim(),
                Headline = string.IsNullOrWhiteSpace(_headline) ? $"{_address.Trim()}, {_suburb.Trim()}" : _headline.Trim(),
                Description = fullDescription,
                Features = JsonSerializer.Serialize(features),
                ImageUrls = images,
                Status = ListingStatus.Active,
                Mode = ListingMode.Exclusive,
                AgreementSigned = true,
                AgreementSignedAt = DateTime.UtcNow,
                AgreementSignature = _agentName.Trim(),
                PublishedAt = DateTime.UtcNow
            };

            _publishedListing = await ListingService.CreateOwnedListingAsync(_currentUserId.Value, listing);

            if (_enableVoiceAssistant)
            {
                _voiceResult = await VoiceClient.ProvisionListingAssistantAsync(new ListingVoiceAssistantRequest(
                    ListingId: _publishedListing.Id,
                    Address: _publishedListing.Address,
                    Suburb: _publishedListing.Suburb,
                    State: _publishedListing.State,
                    Postcode: _publishedListing.Postcode,
                    PropertyType: _publishedListing.PropertyType,
                    PriceDisplay: _publishedListing.PriceDisplay,
                    Bedrooms: _publishedListing.Bedrooms,
                    Bathrooms: _publishedListing.Bathrooms,
                    CarSpaces: _publishedListing.CarSpaces,
                    LandSize: _publishedListing.LandSize,
                    Description: _publishedListing.Description,
                    AgentName: _agentName.Trim(),
                    AgentPhone: _agentPhone.Trim()));
            }

            _draftLoaded = false;
            _importNotice = null;
        }
        catch
        {
            _importError = "Could not publish listing right now. Please verify required fields and try again.";
        }
        finally
        {
            _isPublishing = false;
            StateHasChanged();
        }
    }

    private void ResetDraft()
    {
        _draftLoaded = false;
        _importNotice = null;
        _importError = null;
        _confirmAuthorised = false;
    }

    private async Task CopyLiveLink()
    {
        if (_publishedListing is null) return;
        try
        {
            var url = $"{Navigation.BaseUri.TrimEnd('/')}/property/{_publishedListing.Id}";
            _copied = await JS.InvokeAsync<bool>("ueGlass.copyText", url);
        }
        catch
        {
            _copied = false;
        }
    }
}
