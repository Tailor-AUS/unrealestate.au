@page "/agents"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using System.Security.Claims
@using System.Text.Json
@using Aigents.Domain.Entities
@using Aigents.Domain.Matching
@using Aigents.Infrastructure.Services.AI
@using Aigents.Infrastructure.Services.Import
@using Aigents.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject IListingLinkImporter LinkImporter
@inject IListingService ListingService
@inject ISovrgnVoiceAssistantClient VoiceClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>For Agents — Paste a link, auto-post free forever · unrealestate.au</PageTitle>

<div class="ag-page">
    @* Hero + 1-Link Auto-Post Studio *@
    <section class="ag-hero" id="quick-link-post">
        <div class="ag-hero-bg" aria-hidden="true"></div>
        <div class="ag-hero-scrim" aria-hidden="true"></div>

        <div class="ag-hero-inner">
            <div class="ag-copy">
                <span class="ag-pill-badge">Not-for-profit · Australian-owned · Apache 2.0</span>
                <h1>Paste your listing link. We auto-post it for $0 — forever.</h1>
                <p>
                    Stop making your vendors wire $4,000 upfront to US-owned portals just to test the market.
                    Give us your listing URL — we pull the details, publish for <strong>$0</strong>, and handle buyer
                    <strong>calls, texts &amp; 24/7 AI voice enquiries</strong> straight to you.
                </p>

                <div class="ag-trust-row">
                    <span>✓ $0 listing fees, always</span>
                    <span>✓ Zero margin · Not-for-profit</span>
                    <span>✓ Keep 100% of your commission</span>
                </div>
            </div>

            @* Liquid Glass 1-Link Importer Card *@
            <div class="ag-import-card lg-surface-strong" data-testid="agent-link-importer">
                <div class="ag-import-head">
                    <h2>Auto-post from a link</h2>
                    <span class="ag-free-chip">$0 Forever</span>
                </div>
                <p class="ag-import-sub">
                    Paste any public listing URL from your agency site or portal. We extract structured details automatically.
                </p>

                <div class="ag-url-row">
                    <input type="url"
                           class="lg-input"
                           data-testid="agent-import-url"
                           placeholder="https://youragency.com.au/42-latrobe-terrace-paddington-qld-4064"
                           @bind="_sourceUrl"
                           @bind:event="oninput"
                           @onkeyup="HandleUrlKeyup" />
                    @if (_currentUserId.HasValue)
                    {
                        <button type="button"
                                class="lg-btn lg-btn-primary ag-fetch-btn"
                                data-testid="agent-import-fetch"
                                disabled="@_isImporting"
                                @onclick="ImportFromLinkAsync">
                            @(_isImporting ? "Reading link…" : "Import link")
                        </button>
                    }
                    else
                    {
                        <a href="@LoginReturnHref"
                           class="lg-btn lg-btn-primary ag-fetch-btn"
                           data-testid="agent-signin-to-import">
                            Sign in to import
                        </a>
                    }
                </div>

                @if (!_currentUserId.HasValue)
                {
                    <div class="ag-alert ag-alert-info" role="status">
                        Sign in with your verified agent account to import a link, publish for $0, and receive private buyer enquiries in your Enquiry Hub.
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_importError))
                {
                    <div class="ag-alert ag-alert-error" role="alert">@_importError</div>
                }
                else if (!string.IsNullOrWhiteSpace(_importNotice))
                {
                    <div class="ag-alert ag-alert-info" role="status">@_importNotice</div>
                }

                @if (_currentUserId.HasValue && _draftLoaded)
                {
                    <div class="ag-draft-form" data-testid="agent-import-draft">
                        @if (!string.IsNullOrWhiteSpace(_heroImageUrl))
                        {
                            <div class="ag-draft-thumb">
                                <img src="@_heroImageUrl" alt="Imported listing preview" referrerpolicy="no-referrer" />
                            </div>
                        }

                        <div class="ag-form-grid">
                            <label class="ag-field ag-span-2">
                                <span>Street address *</span>
                                <input class="lg-input" maxlength="200" @bind="_address" placeholder="42 Latrobe Terrace" />
                            </label>
                            <label class="ag-field">
                                <span>Suburb *</span>
                                <input class="lg-input" maxlength="100" @bind="_suburb" placeholder="Paddington" />
                            </label>
                            <div class="ag-row-2">
                                <label class="ag-field">
                                    <span>State *</span>
                                    <select class="lg-select" @bind="_state">
                                        @foreach (var st in ManualAddressResolution.ValidAustralianStates)
                                        {
                                            <option value="@st">@st</option>
                                        }
                                    </select>
                                </label>
                                <label class="ag-field">
                                    <span>Postcode *</span>
                                    <input class="lg-input" maxlength="4" @bind="_postcode" placeholder="4064" />
                                </label>
                            </div>

                            <label class="ag-field">
                                <span>Price guide / display</span>
                                <input class="lg-input" maxlength="100" @bind="_priceDisplay" placeholder="Offers over $1.65M" />
                            </label>
                            <label class="ag-field">
                                <span>Numeric guide ($)</span>
                                <input class="lg-input" type="number" min="0" step="10000" @bind="_askingPrice" placeholder="1650000" />
                            </label>

                            <div class="ag-row-3 ag-span-2">
                                <label class="ag-field">
                                    <span>Beds</span>
                                    <input class="lg-input" type="number" min="0" max="20" @bind="_bedrooms" />
                                </label>
                                <label class="ag-field">
                                    <span>Baths</span>
                                    <input class="lg-input" type="number" min="0" max="15" @bind="_bathrooms" />
                                </label>
                                <label class="ag-field">
                                    <span>Cars</span>
                                    <input class="lg-input" type="number" min="0" max="20" @bind="_carSpaces" />
                                </label>
                            </div>

                            <label class="ag-field ag-span-2">
                                <span>Description</span>
                                <textarea class="lg-textarea" rows="3" maxlength="2000" @bind="_description" placeholder="Key highlights, aspect, school zone, inspection notes..."></textarea>
                            </label>

                            <label class="ag-field">
                                <span>Listing agent name *</span>
                                <input class="lg-input" maxlength="80" @bind="_agentName" placeholder="Sarah Lawson" />
                            </label>
                            <label class="ag-field">
                                <span>Agent mobile (for buyer calls/SMS) *</span>
                                <input class="lg-input" type="tel" maxlength="20" @bind="_agentPhone" placeholder="0412 345 678" />
                            </label>
                        </div>

                        <label class="ag-check">
                            <input type="checkbox" @bind="_enableVoiceAssistant" />
                            <span>
                                <strong>Opt-in: Provision 24/7 ElevenLabs Voice Concierge</strong> via <code>api.sovrgn.ai</code>
                                <small>(answers buyer calls &amp; captures inspection/offer enquiries grounded in these verified facts)</small>
                            </span>
                        </label>

                        <label class="ag-check">
                            <input type="checkbox" @bind="_confirmAuthorised" data-testid="agent-confirm-auth" />
                            <span>I confirm I am authorised by the vendor/agency to publish this listing on unrealestate.au for $0.</span>
                        </label>

                        <div class="ag-publish-actions">
                            <button type="button"
                                    class="lg-btn lg-btn-primary ag-publish-btn"
                                    data-testid="agent-publish-btn"
                                    disabled="@(!CanPublish || _isPublishing)"
                                    @onclick="PublishImportedListingAsync">
                                @(_isPublishing ? "Publishing…" : "Auto-Post Free ($0) →")
                            </button>
                            <button type="button" class="lg-btn lg-btn-secondary" @onclick="ResetDraft">Clear</button>
                        </div>
                    </div>
                }

                @if (_publishedListing is not null)
                {
                    <div class="ag-published-box lg-surface" data-testid="agent-published-result">
                        <div class="ag-pub-badge">✓ Live on unrealestate.au ($0)</div>
                        <h3>@_publishedListing.Address, @_publishedListing.Suburb</h3>
                        <p>Your listing is live for buyers, explainable AI matching, and direct enquiries.</p>
                        @if (_voiceResult is not null)
                        {
                            <div class="ag-voice-note @(_voiceResult.Succeeded ? "ok" : "pending")">
                                <strong>🎙 Voice Concierge:</strong> @_voiceResult.Message
                            </div>
                        }
                        <div class="ag-pub-actions">
                            <a href="@($"/property/{_publishedListing.Id}")" class="lg-btn lg-btn-primary">View live listing →</a>
                            <a href="/enquiries" class="lg-btn lg-btn-secondary">Open Enquiry Hub</a>
                            <button type="button" class="lg-btn lg-btn-secondary" @onclick="CopyLiveLink">@(_copied ? "✓ Copied" : "Copy link")</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    @* Interactive Vendor VPA Savings & Not-For-Profit Pledge *@
    <section class="ag-section">
        <div class="ag-two-col">
            <div class="lg-surface-strong ag-panel">
                <span class="ag-eyebrow">Vendor Cash Kept in Australia</span>
                <h2>See what your office stops sending offshore</h2>
                <p class="ag-muted">
                    News Corp controls ~61% of REA Group. US-based CoStar bought Domain for A$3B in August 2025.
                    Use REA's 1 Jan 2027 25% flex window to run a 14-day $0 pre-market launch first.
                </p>

                <div class="ag-slider-group">
                    <div class="ag-slider-label">
                        <span>Listings per year</span>
                        <strong>@_calcListings / yr</strong>
                    </div>
                    <input type="range" min="4" max="120" step="2" @bind="_calcListings" @bind:event="oninput" class="ag-range" />
                </div>

                <div class="ag-slider-group">
                    <div class="ag-slider-label">
                        <span>Typical portal VPA (REA + Domain)</span>
                        <strong>$@_calcVpa.ToString("N0")</strong>
                    </div>
                    <input type="range" min="2000" max="9000" step="250" @bind="_calcVpa" @bind:event="oninput" class="ag-range" />
                </div>

                <div class="ag-savings-pill">
                    <span>Vendor ad spend kept out of offshore portals</span>
                    <strong>$@((_calcListings * _calcVpa).ToString("N0")) / yr</strong>
                    <small>Listing fee on unrealestate.au: $0 · forever</small>
                </div>
            </div>

            <div class="lg-surface-strong ag-panel">
                <span class="ag-eyebrow">Built for Speed on Mobile</span>
                <h2>Instant enquiry handling included</h2>
                <ul class="ag-feature-list">
                    <li>
                        <strong>1-Link Auto-Post</strong>
                        <span>Paste your existing agency URL — no manual re-typing, no CRM gatekeeping to start.</span>
                    </li>
                    <li>
                        <strong>1-Tap Call &amp; Pre-filled SMS</strong>
                        <span>Every buyer enquiry lands in your phone-native Enquiry Hub with instant tap-to-call and tap-to-text.</span>
                    </li>
                    <li>
                        <strong>24/7 ElevenLabs Voice Concierge (via api.sovrgn.ai)</strong>
                        <span>Answers buyer questions after hours using only your verified listing facts and logs callbacks + inspection requests.</span>
                    </li>
                    <li>
                        <strong>100% Not-for-Profit · Apache 2.0</strong>
                        <span>No subscriptions, no Premiere pay-to-rank, no profit margin, no equity. Hosted in Australia.</span>
                    </li>
                </ul>
                <div class="ag-panel-cta">
                    <a href="/enquiries" class="lg-btn lg-btn-primary">Open Enquiry &amp; Voice Hub →</a>
                    <a href="/agents/register" class="lg-btn lg-btn-secondary">Register agency account</a>
                </div>
            </div>
        </div>
    </section>

    <section class="ag-section">
        <div class="lg-surface-strong ag-sankey-wrap">
            <PhotoTaxSankey />
        </div>
    </section>
</div>

