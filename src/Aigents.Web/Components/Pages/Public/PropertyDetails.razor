@page "/property/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using System.Text.Json
@using Aigents.Domain.Enquiries
@using Aigents.Domain.Entities
@using Aigents.Domain.Finance
@using Aigents.Domain.Matching
@using Aigents.Infrastructure.Services.AI
@using Aigents.Infrastructure.Services.Import
@using Aigents.Web.Services
@implements IDisposable
@inject IListingService ListingService
@inject ISovrgnVoiceAssistantClient VoiceClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_listing is not null ? $"{_listing.Address} | unrealestate.au" : "Property unavailable | unrealestate.au")</PageTitle>

@if (!_loaded)
{
    <div class="pd-state lg-surface-strong" data-testid="property-loading">
        <div class="pd-spinner"></div>
        <p>Loading property details…</p>
    </div>
}
else if (_listing == null)
{
    <div class="pd-state lg-surface-strong" data-testid="property-not-found">
        <h1>Property unavailable</h1>
        <p>This listing is not published or could not be found. Draft, withdrawn, and off-market properties are not publicly accessible.</p>
        <div class="pd-state-actions">
            <a class="lg-btn lg-btn-primary" href="/buyer/matches">Back to buyer matches</a>
            <a class="lg-btn lg-btn-secondary" href="/buy">Browse published listings</a>
        </div>
    </div>
}
else
{
    <div class="pd-page" data-testid="property-details-page">
        @* Full-Bleed Liquid Glass Hero (uses <img> with safe URL validation, never raw CSS url() interpolation) *@
        <section class="pd-hero">
            <img src="@HeroPhotoUrl" alt="" class="pd-hero-photo" referrerpolicy="no-referrer" />
            <div class="pd-hero-scrim"></div>

            <div class="pd-hero-inner">
                <div class="pd-hero-top">
                    <div class="pd-badges">
                        <span class="pd-badge-pub">Published</span>
                        <span class="pd-badge-free">$0 VPA · Not-for-profit</span>
                    </div>
                    <div class="pd-hero-utils">
                        <button type="button"
                                class="pd-glass-icon @(_isSaved ? "saved" : "")"
                                data-testid="save-shortlist-btn"
                                @onclick="ToggleShortlistAsync">
                            @(_isSaved ? "♥ Saved" : "♡ Save")
                        </button>
                        <button type="button" class="pd-glass-icon" @onclick="CopyLinkAsync">Share</button>
                    </div>
                </div>

                <div class="pd-hero-sheet lg-refract">
                    <h1>@_listing.Address</h1>
                    <p class="pd-suburb">@_listing.Suburb@(!string.IsNullOrWhiteSpace(_listing.State) ? $", {_listing.State}" : "") @_listing.Postcode</p>
                    <div class="pd-price-row">
                        <span class="pd-price">@DisplayPrice</span>
                        <span class="pd-mode-pill">
                            @(_listing.Mode == ListingMode.Exclusive
                                ? "Exclusive agency listing · direct to agent"
                                : "OPEN listing · any licensed agent can introduce a buyer")
                        </span>
                    </div>
                </div>
            </div>
        </section>

        @* Verifiable Listing Facts Strip (preserves data-testid, zero fake urgency counters) *@
        <section class="pd-wrap">
            <div class="pd-mobile-inline-bar lg-surface-strong">
                <button type="button" class="lg-btn lg-btn-call pd-mbtn" @onclick="OpenCallModal">📞 Call</button>
                <button type="button" class="lg-btn lg-btn-sms pd-mbtn" @onclick="OpenSmsModal">💬 Text</button>
                <button type="button" class="lg-btn lg-btn-primary pd-mbtn" @onclick="OpenInspection">🗓 Inspect</button>
            </div>

            <div class="pd-facts lg-surface-strong" data-testid="property-verifiable-facts">
                <div class="pd-fact"><strong>Published</strong><span>Status</span></div>
                <div class="pd-fact"><strong>@(string.IsNullOrWhiteSpace(_listing.PropertyType) ? "Unspecified" : _listing.PropertyType)</strong><span>Property type</span></div>
                <div class="pd-fact"><strong>@_listing.Suburb @_listing.Postcode</strong><span>Location</span></div>
                <div class="pd-fact"><strong>@((_listing.PublishedAt ?? _listing.CreatedAt).ToString("dd MMM yyyy"))</strong><span>Listed date</span></div>
            </div>

            <div class="pd-grid">
                <div class="pd-main">
                    <div class="pd-card lg-surface-strong">
                        <div class="pd-specs">
                            <div class="pd-spec"><strong>@(_listing.Bedrooms?.ToString() ?? "—")</strong><span>Bed</span></div>
                            <div class="pd-spec"><strong>@(_listing.Bathrooms?.ToString() ?? "—")</strong><span>Bath</span></div>
                            <div class="pd-spec"><strong>@(_listing.CarSpaces?.ToString() ?? "—")</strong><span>Car</span></div>
                            <div class="pd-spec"><strong>@(_listing.LandSize.HasValue ? $"{_listing.LandSize} m²" : "Not stated")</strong><span>Land</span></div>
                        </div>

                        <h2>About this property</h2>
                        <p class="pd-desc">
                            @(string.IsNullOrWhiteSpace(_listing.Description)
                                ? "No additional description has been supplied for this listing yet."
                                : _listing.Description)
                        </p>

                        @if (_parsedFeatures.Count > 0)
                        {
                            <h3>Supplied Property Features</h3>
                            <ul class="pd-features">
                                @foreach (var feat in _parsedFeatures)
                                {
                                    <li>@feat</li>
                                }
                            </ul>
                        }
                    </div>

                    @* Interactive True Monthly Cost & AU State Stamp Duty Glass Card *@
                    <div class="pd-card lg-surface-strong" data-testid="cost-calculator-card">
                        <div class="pd-calc-head">
                            <div>
                                <span class="pd-eyebrow">Potential Buyer Companion</span>
                                <h2>True Monthly Cost &amp; @CostEstimate.State Stamp Duty</h2>
                            </div>
                            <div class="pd-calc-meta">
                                <select class="lg-select pd-state-select" aria-label="Australian state for stamp duty" @bind="_calcState">
                                    @foreach (var st in ManualAddressResolution.ValidAustralianStates)
                                    {
                                        <option value="@st">@st</option>
                                    }
                                </select>
                                <span class="pd-rate-chip">@CostEstimate.AnnualInterestRatePercent.ToString("0.0")% · @CostEstimate.LoanTermYears yrs</span>
                            </div>
                        </div>

                        @if (_priceIsAssumed)
                        {
                            <p class="pd-assumed-note">No price was supplied on this listing — slider starts at an example price ($1,100,000).</p>
                        }

                        <div class="pd-calc-controls">
                            <label class="pd-slider-row">
                                <span>Offer / purchase price</span>
                                <strong>$@_calcPrice.ToString("N0")</strong>
                                <input type="range" min="@_calcSliderMin" max="@_calcSliderMax" step="25000" @bind="_calcPrice" @bind:event="oninput" />
                            </label>
                            <label class="pd-slider-row">
                                <span>Deposit (@_calcDepositPct%)</span>
                                <strong>$@CostEstimate.DepositAmount.ToString("N0")</strong>
                                <input type="range" min="10" max="50" step="5" @bind="_calcDepositPct" @bind:event="oninput" />
                            </label>
                        </div>

                        <div class="pd-buyer-types" role="radiogroup" aria-label="Buyer type">
                            <button type="button" class="pd-seg @(_buyerType == BuyerOccupancyType.OwnerOccupier ? "active" : "")" @onclick="() => _buyerType = BuyerOccupancyType.OwnerOccupier">Owner-Occupier</button>
                            <button type="button" class="pd-seg @(_buyerType == BuyerOccupancyType.FirstHomeBuyer ? "active" : "")" @onclick="() => _buyerType = BuyerOccupancyType.FirstHomeBuyer">First Home</button>
                            <button type="button" class="pd-seg @(_buyerType == BuyerOccupancyType.Investor ? "active" : "")" @onclick="() => _buyerType = BuyerOccupancyType.Investor">Investor</button>
                        </div>

                        <div class="pd-calc-readout lg-surface">
                            <div>
                                <span>Est. monthly repayment</span>
                                <strong>$@CostEstimate.EstimatedMonthlyRepayment.ToString("N0")/mo</strong>
                            </div>
                            <div>
                                <span>Est. @CostEstimate.State stamp duty</span>
                                <strong>$@CostEstimate.EstimatedStampDuty.ToString("N0")</strong>
                            </div>
                            <div>
                                <span>Total upfront (dep + duty)</span>
                                <strong>$@CostEstimate.TotalUpfrontRequired.ToString("N0")</strong>
                            </div>
                        </div>
                        <p class="pd-disclaimer">@CostEstimate.Disclaimer</p>
                    </div>
                </div>

                @* Right column: Direct Buyer Enquiry Console (Call · Text · Voice AI · Inspect · Offer) *@
                <aside class="pd-sidebar">
                    <div class="pd-card lg-surface-strong pd-sticky-card">
                        <span class="pd-eyebrow">Direct Enquiry · Zero Middleman</span>
                        <h3>Talk, text or inspect</h3>
                        <p class="pd-side-sub">Every enquiry routes straight to the listing representative — never sold to third-party lead brokers.</p>

                        <div class="pd-quick-channels">
                            <button type="button" class="lg-btn lg-btn-call" data-testid="enquiry-call-btn" @onclick="OpenCallModal">
                                📞 Call / Callback
                            </button>
                            <button type="button" class="lg-btn lg-btn-sms" data-testid="enquiry-sms-btn" @onclick="OpenSmsModal">
                                💬 Text Agent
                            </button>
                        </div>

                        <button type="button" class="lg-btn lg-btn-secondary pd-full" data-testid="enquiry-voice-btn" @onclick="OpenVoiceModal">
                            🎙 Ask 24/7 Voice Concierge (ElevenLabs)
                        </button>

                        <div class="pd-divider"></div>

                        <button type="button" class="lg-btn lg-btn-primary pd-full" @onclick="OpenInspection">
                            🗓 Book Inspection
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary pd-full" @onclick="MakeOffer">
                            🏷 Make an Offer
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary pd-full" @onclick="OpenEnquiry">
                            ❓ Ask a Question
                        </button>

                        <div class="pd-agent-foot">
                            <div class="pd-avatar">L</div>
                            <div>
                                <strong>Listing Representative</strong>
                                <span>Direct via unrealestate.au</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        @* Call / Callback Sheet *@
        @if (_showCallModal)
        {
            <div class="lg-sheet-backdrop" @onclick="CloseAllModals">
                <div class="lg-sheet" @onclick:stopPropagation>
                    <div class="lg-sheet-handle"></div>
                    <h3>Request an instant callback</h3>
                    <p class="pd-sheet-sub">Leave your mobile — the listing representative gets a 1-tap Call button in their private Enquiry Hub.</p>
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="pd-modal-err" role="alert">@_modalError</div>
                    }
                    <div class="pd-form-stack">
                        <label>Your name <input class="lg-input" maxlength="80" @bind="_buyerName" placeholder="Sienna Brooks" /></label>
                        <label>Mobile number * <input class="lg-input" type="tel" maxlength="20" @bind="_buyerPhone" placeholder="04xx xxx xxx" /></label>
                        <label>Best time / note <input class="lg-input" maxlength="400" @bind="_callNote" placeholder="Call me today after 3pm about inspection" /></label>
                    </div>
                    <div class="pd-sheet-actions">
                        <button type="button" class="lg-btn lg-btn-call" disabled="@_submitting" @onclick="SubmitCallRequestAsync">
                            @(_submitting ? "Sending…" : "Request callback")
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary" @onclick="CloseAllModals">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @* SMS / Text Sheet with 1-Tap Quick Chips *@
        @if (_showSmsModal)
        {
            <div class="lg-sheet-backdrop" @onclick="CloseAllModals">
                <div class="lg-sheet" @onclick:stopPropagation>
                    <div class="lg-sheet-handle"></div>
                    <h3>Text the listing agent</h3>
                    <p class="pd-sheet-sub">Tap a quick question or write your own — agent can reply straight via SMS.</p>
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="pd-modal-err" role="alert">@_modalError</div>
                    }
                    <div class="pd-quick-chips">
                        @foreach (var q in _quickSmsChips)
                        {
                            var chip = q;
                            <button type="button" class="pd-chip" @onclick="() => _smsText = chip">@chip</button>
                        }
                    </div>
                    <div class="pd-form-stack">
                        <label>Your name <input class="lg-input" maxlength="80" @bind="_buyerName" placeholder="Sienna Brooks" /></label>
                        <label>Your mobile (for SMS reply) <input class="lg-input" type="tel" maxlength="20" @bind="_buyerPhone" placeholder="04xx xxx xxx" /></label>
                        <label>Message * <textarea class="lg-textarea" rows="3" maxlength="1000" @bind="_smsText" placeholder="Hi, is this weekend's inspection open?"></textarea></label>
                    </div>
                    <div class="pd-sheet-actions">
                        <button type="button" class="lg-btn lg-btn-sms" disabled="@_submitting" @onclick="SubmitSmsAsync">
                            @(_submitting ? "Sending…" : "Send text enquiry")
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary" @onclick="CloseAllModals">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @* 24/7 ElevenLabs Voice Concierge Sheet *@
        @if (_showVoiceModal)
        {
            <div class="lg-sheet-backdrop" @onclick="CloseAllModals">
                <div class="lg-sheet" @onclick:stopPropagation>
                    <div class="lg-sheet-handle"></div>
                    <span class="pd-eyebrow">ElevenLabs via api.sovrgn.ai/v1/convai</span>
                    <h3>24/7 Listing Voice Concierge</h3>
                    <p class="pd-sheet-sub">
                        @(VoiceClient.IsConfigured
                            ? "Voice routing via api.sovrgn.ai is configured. Leave your question or request an AI concierge callback."
                            : "Live ElevenLabs voice sessions activate once SOVRGN_API_KEY is configured in production. You can still log a voice-concierge callback request right now — it routes directly to the listing representative.")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="pd-modal-err" role="alert">@_modalError</div>
                    }
                    <div class="pd-form-stack">
                        <label>Your name <input class="lg-input" maxlength="80" @bind="_buyerName" placeholder="Sienna Brooks" /></label>
                        <label>Your mobile <input class="lg-input" type="tel" maxlength="20" @bind="_buyerPhone" placeholder="04xx xxx xxx" /></label>
                        <label>What would you like answered? * <textarea class="lg-textarea" rows="2" maxlength="1000" @bind="_voiceQuestion" placeholder="Council rates, school catchment, or private inspection time"></textarea></label>
                    </div>
                    <div class="pd-sheet-actions">
                        <button type="button" class="lg-btn lg-btn-primary" disabled="@_submitting" @onclick="SubmitVoiceEnquiryAsync">
                            @(_submitting ? "Logging…" : "Log voice enquiry")
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary" @onclick="CloseAllModals">Close</button>
                    </div>
                </div>
            </div>
        }

        @* Ask Question Sheet *@
        @if (_showEnquiryModal)
        {
            <div class="lg-sheet-backdrop" @onclick="CloseAllModals">
                <div class="lg-sheet" @onclick:stopPropagation>
                    <div class="lg-sheet-handle"></div>
                    <h3>Ask a question</h3>
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="pd-modal-err" role="alert">@_modalError</div>
                    }
                    <div class="pd-form-stack">
                        <label>Your name <input class="lg-input" maxlength="80" @bind="_enqName" placeholder="Sienna Brooks" /></label>
                        <label>Email <input class="lg-input" type="email" maxlength="120" @bind="_enqEmail" placeholder="you@example.com" /></label>
                        <label>Question * <textarea class="lg-textarea" rows="3" maxlength="1000" @bind="_enqMessage" placeholder="Is the rear deck staying? When can I inspect?"></textarea></label>
                    </div>
                    <div class="pd-sheet-actions">
                        <button type="button" class="lg-btn lg-btn-primary" disabled="@_submitting" @onclick="SubmitEnquiry">
                            @(_submitting ? "Sending…" : "Send question")
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary" @onclick="CloseAllModals">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @* Inspection Booking Sheet *@
        @if (_showInspectionModal)
        {
            <div class="lg-sheet-backdrop" @onclick="CloseAllModals">
                <div class="lg-sheet" @onclick:stopPropagation>
                    <div class="lg-sheet-handle"></div>
                    <h3>Book an inspection</h3>
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="pd-modal-err" role="alert">@_modalError</div>
                    }
                    <div class="pd-form-stack">
                        <label>Your name <input class="lg-input" maxlength="80" @bind="_inspName" placeholder="Sienna Brooks" /></label>
                        <label>Mobile <input class="lg-input" type="tel" maxlength="20" @bind="_inspPhone" placeholder="04xx xxx xxx" /></label>
                        <div>
                            <div class="pd-slot-label">Preferred slot *</div>
                            <div class="pd-slot-grid">
                                @foreach (var slot in _inspectionSlots)
                                {
                                    var s = slot;
                                    <button type="button" class="pd-slot @(_inspSlot == s ? "selected" : "")" @onclick="() => _inspSlot = s">@s</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="pd-sheet-actions">
                        <button type="button" class="lg-btn lg-btn-primary" @onclick="SubmitInspection" disabled="@(_submitting || string.IsNullOrEmpty(_inspSlot))">
                            @(_submitting ? "Booking…" : "Request slot")
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary" @onclick="CloseAllModals">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @* Offer Sheet *@
        @if (_showOfferModal)
        {
            <div class="lg-sheet-backdrop" @onclick="CloseAllModals">
                <div class="lg-sheet" @onclick:stopPropagation>
                    <div class="lg-sheet-handle"></div>
                    <h3>Make an Offer</h3>
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <div class="pd-modal-err" role="alert">@_modalError</div>
                    }
                    <div class="pd-form-stack">
                        <label>Your Offer Price ($) * <input class="lg-input" type="number" min="1" step="1000" @bind="_offerPrice" placeholder="e.g. 1200000" /></label>
                        <label>Your Name <input class="lg-input" maxlength="80" @bind="_offerName" placeholder="Sienna Brooks" /></label>
                        <label>Mobile <input class="lg-input" type="tel" maxlength="20" @bind="_buyerPhone" placeholder="04xx xxx xxx" /></label>
                        <label>Conditions / settlement terms <textarea class="lg-textarea" rows="3" maxlength="1000" @bind="_offerMessage" placeholder="e.g. 30-day settlement, pre-approved finance"></textarea></label>
                    </div>
                    <div class="pd-sheet-actions">
                        <button type="button" class="lg-btn lg-btn-primary" disabled="@_submitting" @onclick="SubmitOffer">
                            @(_submitting ? "Submitting…" : "Submit Offer")
                        </button>
                        <button type="button" class="lg-btn lg-btn-secondary" @onclick="CloseAllModals">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (_toast is not null)
        {
            <div class="pd-toast lg-surface-strong" role="status">@_toast</div>
        }
    </div>
}

<style>
    .pd-state { max-width: 580px; margin: 48px auto; padding: 30px; border-radius: 30px; text-align: center; }
    .pd-state h1 { margin: 0 0 10px; font-size: 26px; }
    .pd-state p { margin: 0 0 20px; color: var(--lg-ink-secondary); line-height: 1.6; }
    .pd-state-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

    .pd-page { padding-bottom: 40px; }

    .pd-hero {
        position: relative;
        min-height: 52svh;
        padding: calc(96px + env(safe-area-inset-top, 0px)) 16px 28px;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
    }

    .pd-hero-photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .pd-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16, 28, 46, 0.36) 0%, rgba(12, 22, 38, 0.12) 42%, rgba(8, 18, 34, 0.56) 100%); }
    .pd-hero-inner { position: relative; z-index: 2; max-width: 1140px; width: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
    .pd-hero-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    .pd-badges, .pd-hero-utils { display: flex; gap: 8px; flex-wrap: wrap; }

    .pd-badge-pub, .pd-badge-free { padding: 5px 12px; border-radius: 9999px; font-size: 12px; font-weight: 700; color: #ffffff; backdrop-filter: blur(16px); }
    .pd-badge-pub { background: rgba(16, 185, 129, 0.78); }
    .pd-badge-free { background: rgba(12, 20, 36, 0.54); border: 1px solid rgba(255, 255, 255, 0.34); }

    .pd-glass-icon { min-height: 38px; padding: 0 14px; border-radius: 9999px; border: 1px solid rgba(255, 255, 255, 0.45); background: rgba(12, 20, 36, 0.48); backdrop-filter: blur(18px); color: #ffffff; font-size: 13px; font-weight: 600; cursor: pointer; }
    .pd-glass-icon.saved { background: rgba(239, 68, 68, 0.85); border-color: rgba(255, 255, 255, 0.7); }

    .pd-hero-sheet { border-radius: 28px; padding: 20px 22px; color: #ffffff; background: linear-gradient(135deg, rgba(16, 30, 48, 0.42) 0%, rgba(12, 24, 40, 0.56) 100%); text-shadow: 0 1px 12px rgba(8, 18, 34, 0.35); }
    .pd-hero-sheet h1 { margin: 0; font-size: clamp(24px, 4.4vw, 38px); font-weight: 800; letter-spacing: -0.03em; }
    .pd-suburb { margin: 4px 0 12px; font-size: 15px; color: rgba(255, 255, 255, 0.92); }
    .pd-price-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
    .pd-price { font-size: clamp(22px, 3.2vw, 30px); font-weight: 700; color: #ffffff; }
    .pd-mode-pill { font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 9999px; background: rgba(16, 185, 129, 0.32); border: 1px solid rgba(255, 255, 255, 0.34); }

    .pd-wrap { max-width: 1140px; margin: 18px auto 0; padding: 0 16px; display: flex; flex-direction: column; gap: 18px; }
    .pd-mobile-inline-bar { border-radius: 9999px; padding: 6px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    @@media (min-width: 900px) { .pd-mobile-inline-bar { display: none; } }
    .pd-mbtn { min-height: 40px; padding: 6px 10px; font-size: 13px; }

    .pd-facts { border-radius: 24px; padding: 14px 20px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    @@media (min-width: 680px) { .pd-facts { grid-template-columns: repeat(4, 1fr); } }
    .pd-fact { display: flex; flex-direction: column; gap: 2px; }
    .pd-fact strong { font-size: 15px; font-weight: 700; }
    .pd-fact span { font-size: 12px; color: var(--lg-ink-secondary); }

    .pd-grid { display: grid; grid-template-columns: 1fr; gap: 18px; align-items: start; }
    @@media (min-width: 900px) { .pd-grid { grid-template-columns: 1.55fr 1fr; } }
    .pd-main { display: flex; flex-direction: column; gap: 18px; }
    .pd-card { border-radius: 28px; padding: 22px; }

    .pd-specs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid var(--lg-border-subtle); text-align: center; }
    .pd-spec { display: flex; flex-direction: column; gap: 2px; }
    .pd-spec strong { font-size: 18px; font-weight: 800; }
    .pd-spec span { font-size: 12px; color: var(--lg-ink-secondary); }

    .pd-card h2 { margin: 0 0 10px; font-size: 20px; letter-spacing: -0.02em; }
    .pd-card h3 { margin: 16px 0 8px; font-size: 16px; }
    .pd-desc { margin: 0; font-size: 15px; line-height: 1.65; color: var(--lg-ink-secondary); }
    .pd-features { margin: 0; padding-left: 18px; display: grid; grid-template-columns: 1fr; gap: 6px; font-size: 14px; color: var(--lg-ink-secondary); }
    @@media (min-width: 600px) { .pd-features { grid-template-columns: 1fr 1fr; } }

    .pd-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--lg-emerald); }
    .pd-calc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
    .pd-calc-meta { display: flex; align-items: center; gap: 8px; }
    .pd-state-select { width: auto; padding: 5px 10px; border-radius: 9999px; font-size: 12px; font-weight: 700; }
    .pd-rate-chip { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 9999px; background: var(--lg-emerald-soft); color: var(--lg-emerald); white-space: nowrap; }
    .pd-assumed-note { margin: 0 0 12px; font-size: 12px; color: var(--lg-amber); }

    .pd-calc-controls { display: grid; gap: 12px; margin-bottom: 14px; }
    .pd-slider-row { display: grid; grid-template-columns: 1fr auto; gap: 6px; font-size: 13px; }
    .pd-slider-row input { grid-column: 1 / -1; width: 100%; accent-color: #10b981; }

    .pd-buyer-types { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 14px; }
    .pd-seg { padding: 8px 6px; border-radius: 9999px; border: 1px solid var(--lg-border-subtle); background: transparent; color: var(--lg-ink-secondary); font-size: 12px; font-weight: 600; cursor: pointer; }
    .pd-seg.active { background: var(--lg-glass-thumb); color: var(--lg-ink); border-color: var(--lg-border); }

    .pd-calc-readout { border-radius: 20px; padding: 14px; display: grid; grid-template-columns: 1fr; gap: 12px; }
    @@media (min-width: 560px) { .pd-calc-readout { grid-template-columns: repeat(3, 1fr); } }
    .pd-calc-readout span { display: block; font-size: 12px; color: var(--lg-ink-secondary); }
    .pd-calc-readout strong { display: block; font-size: 19px; font-weight: 800; color: var(--lg-emerald); margin-top: 2px; }
    .pd-disclaimer { margin: 12px 0 0; font-size: 12px; line-height: 1.5; color: var(--lg-ink-muted); }

    .pd-sticky-card { position: sticky; top: 82px; display: flex; flex-direction: column; gap: 10px; }
    .pd-sticky-card h3 { margin: 2px 0 0; font-size: 20px; }
    .pd-side-sub { margin: 0 0 6px; font-size: 13px; line-height: 1.5; color: var(--lg-ink-secondary); }
    .pd-quick-channels { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .pd-full { width: 100%; }
    .pd-divider { height: 1px; background: var(--lg-border-subtle); margin: 4px 0; }
    .pd-agent-foot { margin-top: 8px; padding-top: 14px; border-top: 1px solid var(--lg-border-subtle); display: flex; align-items: center; gap: 10px; font-size: 13px; }
    .pd-avatar { width: 40px; height: 40px; border-radius: 9999px; background: linear-gradient(135deg, #059669, #0284c7); color: #ffffff; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pd-agent-foot span { display: block; font-size: 12px; color: var(--lg-ink-secondary); }

    .pd-sheet-sub { margin: 4px 0 14px; font-size: 13px; line-height: 1.5; color: var(--lg-ink-secondary); }
    .pd-modal-err { margin-bottom: 12px; padding: 10px 12px; border-radius: 12px; background: var(--lg-danger-soft); color: var(--lg-danger); font-size: 13px; font-weight: 600; }
    .pd-form-stack { display: grid; gap: 12px; margin-bottom: 16px; }
    .pd-form-stack label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 600; color: var(--lg-ink-secondary); }
    .pd-sheet-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .pd-sheet-actions > button { flex: 1; }

    .pd-quick-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
    .pd-chip { padding: 6px 11px; border-radius: 9999px; border: 1px solid var(--lg-border-subtle); background: var(--lg-glass); color: var(--lg-ink); font-size: 12px; cursor: pointer; }
    .pd-slot-label { font-size: 12px; font-weight: 600; color: var(--lg-ink-secondary); margin-bottom: 6px; }
    .pd-slot-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .pd-slot { padding: 10px; border-radius: 14px; border: 1px solid var(--lg-border-subtle); background: var(--lg-input-bg); color: var(--lg-ink); font-weight: 600; font-size: 13px; cursor: pointer; }
    .pd-slot.selected { background: #10b981; border-color: #10b981; color: #ffffff; }

    .pd-toast { position: fixed; top: calc(74px + env(safe-area-inset-top, 0px)); left: 50%; transform: translateX(-50%); padding: 10px 18px; border-radius: 9999px; font-size: 13px; font-weight: 600; z-index: 140; }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Listing? _listing;
    private Guid? _shortlistCheckedForId;
    private bool _loaded;
    private bool _isSaved;
    private bool _submitting;
    private List<string> _parsedFeatures = [];

    private decimal _calcPrice = 1_100_000m;
    private decimal _calcSliderMin = 200_000m;
    private decimal _calcSliderMax = 5_000_000m;
    private int _calcDepositPct = 20;
    private string _calcState = "QLD";
    private bool _priceIsAssumed;
    private BuyerOccupancyType _buyerType = BuyerOccupancyType.OwnerOccupier;

    private PropertyCostEstimate CostEstimate => PropertyCostCalculator.Calculate(
        _calcPrice,
        _calcState,
        _buyerType,
        _calcDepositPct);

    private bool _showCallModal;
    private bool _showSmsModal;
    private bool _showVoiceModal;
    private bool _showOfferModal;
    private bool _showEnquiryModal;
    private bool _showInspectionModal;
    private string? _modalError;

    private string _buyerName = "";
    private string _buyerPhone = "";
    private string _callNote = "";
    private string _smsText = "";
    private string _voiceQuestion = "";

    private decimal? _offerPrice;
    private string _offerName = "";
    private string _offerMessage = "";

    private string _enqName = "";
    private string _enqEmail = "";
    private string _enqMessage = "";

    private string _inspName = "";
    private string _inspPhone = "";
    private string _inspSlot = "";
    private readonly string[] _inspectionSlots =
    [
        "Sat 10:00 am", "Sat 11:30 am", "Sat 1:00 pm",
        "Sun 10:00 am", "Sun 11:30 am",
        "Wed 5:30 pm"
    ];

    private readonly string[] _quickSmsChips =
    [
        "When is the next open home?",
        "What's the current price guide?",
        "Can you send the contract & disclosure?",
        "Is a private inspection available?"
    ];

    private string? _toast;
    private CancellationTokenSource? _toastCts;

    private string DisplayPrice
    {
        get
        {
            if (_listing is null) return "";
            if (!string.IsNullOrWhiteSpace(_listing.PriceDisplay)) return _listing.PriceDisplay;
            if (_listing.AskingPrice is decimal a && a > 0) return $"${a:N0}";
            if (_listing.EstimatedValue is decimal e && e > 0) return $"~${e:N0} (illustrative estimate)";
            return "Contact Agent";
        }
    }

    private string HeroPhotoUrl
    {
        get
        {
            if (_listing is not null && !string.IsNullOrWhiteSpace(_listing.ImageUrls) && _listing.ImageUrls.StartsWith('['))
            {
                try
                {
                    var urls = JsonSerializer.Deserialize<string[]>(_listing.ImageUrls);
                    var safe = urls?.Select(SanitizeRenderImageUrl).FirstOrDefault(u => u is not null);
                    if (!string.IsNullOrWhiteSpace(safe)) return safe;
                }
                catch { }
            }
            return "/images/hero-queenslander.jpg";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _isSaved = false;
        _shortlistCheckedForId = null;
        _listing = await ListingService.GetPublishedListingByIdAsync(Id);
        if (_listing is not null)
        {
            _parsedFeatures = ParseFeatures(_listing.Features);
            _calcState = PropertyCostCalculator.NormalizeState(_listing.State);
            var rawSeed = _listing.AskingPrice ?? _listing.EstimatedValue;
            _priceIsAssumed = rawSeed is null || rawSeed <= 0;
            var seedPrice = _priceIsAssumed ? 1_100_000m : rawSeed!.Value;
            var rounded = Math.Round(seedPrice / 25_000m) * 25_000m;
            _calcSliderMin = Math.Min(200_000m, Math.Max(50_000m, rounded));
            _calcSliderMax = Math.Max(5_000_000m, rounded + 1_000_000m);
            _calcPrice = Math.Clamp(rounded, _calcSliderMin, _calcSliderMax);
        }
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_listing is not null && _shortlistCheckedForId != _listing.Id)
        {
            _shortlistCheckedForId = _listing.Id;
            try
            {
                _isSaved = await JS.InvokeAsync<bool>("ueGlass.isShortlisted", _listing.Id.ToString());
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleShortlistAsync()
    {
        if (_listing is null) return;
        try
        {
            _isSaved = await JS.InvokeAsync<bool>("ueGlass.toggleShortlist", new
            {
                id = _listing.Id.ToString(),
                address = _listing.Address,
                suburb = _listing.Suburb,
                state = string.IsNullOrWhiteSpace(_listing.State) ? "QLD" : _listing.State,
                postcode = _listing.Postcode,
                priceDisplay = DisplayPrice,
                askingPrice = _listing.AskingPrice ?? _listing.EstimatedValue,
                bedrooms = _listing.Bedrooms,
                bathrooms = _listing.Bathrooms,
                carSpaces = _listing.CarSpaces,
                propertyType = _listing.PropertyType
            });
            Toast(_isSaved ? "♥ Saved to your phone shortlist." : "Removed from shortlist.");
        }
        catch { }
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("ueGlass.copyText", Navigation.Uri);
            Toast(ok ? "✓ Property link copied." : "Copy unavailable in this browser.");
        }
        catch
        {
            Toast("Copy unavailable in this browser.");
        }
    }

    private void CloseAllModals()
    {
        _showCallModal = false;
        _showSmsModal = false;
        _showVoiceModal = false;
        _showOfferModal = false;
        _showEnquiryModal = false;
        _showInspectionModal = false;
        _modalError = null;
    }

    private void OpenCallModal() { CloseAllModals(); _showCallModal = true; }
    private void OpenSmsModal() { CloseAllModals(); _showSmsModal = true; }
    private void OpenVoiceModal() { CloseAllModals(); _showVoiceModal = true; }
    private void MakeOffer() { CloseAllModals(); _showOfferModal = true; }
    private void OpenEnquiry() { CloseAllModals(); _showEnquiryModal = true; }
    private void OpenInspection() { CloseAllModals(); _showInspectionModal = true; }

    private async Task SubmitCallRequestAsync()
    {
        if (string.IsNullOrWhiteSpace(_buyerPhone) || EnquiryRecordCodec.NormalizeDialablePhone(_buyerPhone) is null)
        {
            _modalError = "Enter a valid Australian phone or mobile number.";
            return;
        }
        var ok = await RecordInquiryAsync(
            EnquiryChannel.CallRequest,
            string.IsNullOrWhiteSpace(_callNote) ? "Callback requested" : _callNote,
            _buyerName, _buyerPhone, null, null, null, InquiryStatus.New,
            "✓ Callback logged for the listing representative.");
        if (ok) { CloseAllModals(); _callNote = ""; }
    }

    private async Task SubmitSmsAsync()
    {
        if (string.IsNullOrWhiteSpace(_smsText))
        {
            _modalError = "Enter a message to send.";
            return;
        }
        var ok = await RecordInquiryAsync(
            EnquiryChannel.SmsText,
            _smsText, _buyerName, _buyerPhone, null, null, null, InquiryStatus.New,
            "✓ Text enquiry logged for the listing representative.");
        if (ok) { CloseAllModals(); _smsText = ""; }
    }

    private async Task SubmitVoiceEnquiryAsync()
    {
        if (string.IsNullOrWhiteSpace(_voiceQuestion))
        {
            _modalError = "Enter what you would like answered.";
            return;
        }
        var ok = await RecordInquiryAsync(
            EnquiryChannel.VoiceAssistant,
            _voiceQuestion, _buyerName, _buyerPhone, null, null, null, InquiryStatus.New,
            "✓ Voice concierge enquiry logged for the listing representative.");
        if (ok) { CloseAllModals(); _voiceQuestion = ""; }
    }

    private async Task SubmitEnquiry()
    {
        if (string.IsNullOrWhiteSpace(_enqMessage))
        {
            _modalError = "Enter your question before sending.";
            return;
        }
        var ok = await RecordInquiryAsync(
            EnquiryChannel.Question,
            _enqMessage, _enqName, null, _enqEmail, null, null, InquiryStatus.New,
            "✓ Question recorded for the listing representative.");
        if (ok) { CloseAllModals(); _enqMessage = ""; }
    }

    private async Task SubmitInspection()
    {
        if (string.IsNullOrEmpty(_inspSlot))
        {
            _modalError = "Choose a preferred inspection slot.";
            return;
        }
        var ok = await RecordInquiryAsync(
            EnquiryChannel.Inspection,
            "Inspection requested", _inspName, _inspPhone, null, _inspSlot, null, InquiryStatus.InspectionBooked,
            $"✓ Inspection request recorded for {_inspSlot}.");
        if (ok) { CloseAllModals(); _inspSlot = ""; }
    }

    private async Task SubmitOffer()
    {
        if (!_offerPrice.HasValue || _offerPrice.Value <= 0)
        {
            _modalError = "Enter a positive offer amount in dollars.";
            return;
        }
        var ok = await RecordInquiryAsync(
            EnquiryChannel.Offer,
            string.IsNullOrWhiteSpace(_offerMessage) ? "Offer submitted" : _offerMessage,
            _offerName, _buyerPhone, null, null, _offerPrice, InquiryStatus.OfferMade,
            "✓ Offer recorded for the listing representative.");
        if (ok) { CloseAllModals(); _offerMessage = ""; }
    }

    private async Task<bool> RecordInquiryAsync(
        EnquiryChannel channel,
        string summary,
        string? name,
        string? phone,
        string? email,
        string? slot,
        decimal? offerAmount,
        InquiryStatus status,
        string successToast)
    {
        if (_listing is null || _submitting) return false;
        _submitting = true;
        _modalError = null;
        try
        {
            var inquiry = new ListingInquiry
            {
                Id = Guid.NewGuid(),
                ListingId = _listing.Id,
                Message = EnquiryRecordCodec.Encode(channel, summary, name, phone, email, slot, offerAmount),
                Status = status,
                CreatedAt = DateTime.UtcNow
            };

            var ok = await ListingService.AddPublishedListingInquiryAsync(_listing.Id, inquiry);
            Toast(ok ? successToast : "This property is no longer published.");
            return ok;
        }
        catch
        {
            _modalError = "Unable to save your enquiry right now. Please try again.";
            return false;
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string? SanitizeRenderImageUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var trimmed = raw.Trim();
        if (trimmed.StartsWith('/')
            && !trimmed.StartsWith("//", StringComparison.Ordinal)
            && !trimmed.StartsWith("/\\", StringComparison.Ordinal))
            return trimmed;
        return ListingLinkImporter.SanitizeImageUrl(trimmed, new Uri("https://unrealestate.au/"));
    }

    private static List<string> ParseFeatures(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return [];
        var trimmed = raw.Trim();
        if (trimmed.StartsWith('['))
        {
            try
            {
                var arr = JsonSerializer.Deserialize<string[]>(trimmed);
                if (arr is not null)
                    return arr.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim()).ToList();
            }
            catch { }
        }

        return trimmed
            .Split(['\n', ','], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToList();
    }

    private void Toast(string message)
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = message;
        _ = HideToastAsync(token);
    }

    private async Task HideToastAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(3500, ct);
            _toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
}
