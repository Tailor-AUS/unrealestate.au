@page "/property/{Id:guid}"
@using Aigents.Web.Services
@using Aigents.Domain.Entities
@inject IListingService ListingService
@inject NavigationManager Navigation

<PageTitle>@_listing?.Address | Premium Property</PageTitle>

@if (_listing == null)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading property details...</p>
    </div>
}
else
{
    <div class="property-page">
        <!-- Hero Section -->
        <div class="hero-section">
            <div class="hero-content">
                <span class="status-badge">@_listing.Status</span>
                <h1>@_listing.Address</h1>
                <p class="suburb">@_listing.Suburb, @_listing.State @_listing.Postcode</p>
                <div class="price-tag">
                    @_listing.PriceDisplay
                </div>
                <div class="status-row">
                    <span class="status-pill open">OPEN listing · any agent can sell it</span>
                </div>
            </div>
        </div>

        <!-- Live activity strip: social proof for buyers -->
        <div class="activity-strip">
            <div class="activity-pulse" aria-hidden="true"></div>
            <div class="activity-stat"><strong>@_viewersToday</strong><span>viewing today</span></div>
            <div class="activity-stat"><strong>@_enquiriesToday</strong><span>enquiries (24h)</span></div>
            <div class="activity-stat"><strong>@_offersTotal</strong><span>offers received</span></div>
            <div class="activity-stat"><strong>@_savedCount</strong><span>buyers saved</span></div>
            <div class="activity-meta">Last enquiry @_lastEnquiryAgo ago</div>
        </div>

        <!-- Main Content -->
        <div class="content-grid">
            <!-- Left Column: Details -->
            <div class="main-details">
                <div class="key-features">
                    <div class="feature">
                        <span class="icon">🛏</span>
                        <span class="value">@_listing.Bedrooms</span>
                        <span class="label">Bed</span>
                    </div>
                    <div class="feature">
                        <span class="icon">🛁</span>
                        <span class="value">@_listing.Bathrooms</span>
                        <span class="label">Bath</span>
                    </div>
                    <div class="feature">
                        <span class="icon">🚗</span>
                        <span class="value">@_listing.CarSpaces</span>
                        <span class="label">Car</span>
                    </div>
                    <div class="feature">
                        <span class="icon">📐</span>
                        <span class="value">@(_listing.LandSize.HasValue ? _listing.LandSize + " m²" : "Large Block")</span>
                        <span class="label">Land</span>
                    </div>
                </div>

                <div class="description-section">
                    <h2>About this property</h2>
                    <p>@_listing.Description</p>
                    
                    <h3>Property Features</h3>
                    <ul class="features-list">
                        <li>Premium Location</li>
                        <li>Modern Design</li>
                        <li>Spacious Living Areas</li>
                        <li>Close to Transport</li>
                    </ul>
                </div>
            </div>

            <!-- Right Column: Action Card -->
            <div class="action-sidebar">
                <div class="action-card">
                    <h3>Interested?</h3>
                    <p>Make an offer or enquire directly with the owner.</p>
                    
                    <button class="primary-btn pulse" @onclick="MakeOffer">
                        Make an Offer
                    </button>

                    <button class="secondary-btn" @onclick="OpenEnquiry">
                        Ask a question
                    </button>

                    <button class="ghost-btn" @onclick="OpenInspection">
                        Book inspection
                    </button>

                    <div class="agent-profile">
                        <div class="avatar">H</div>
                        <div class="details">
                            <span class="name">Direct to Homeowner</span>
                            <span class="role">No agent fee · powered by unreal.estate</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sell-side promo: convert browsing buyers into sellers -->
        <div class="sell-promo-wrap">
            <SellPromoBanner Headline="Selling too? List your own home free in 3 minutes."
                             Sub="No marketing tax, no $3,000 cheque to a US portal. Drop your address, snap your photos — our AI writes the copy and stages the photos in seconds. Drag the slider to see it."
                             Meta="Australian-owned · not-for-profit · ~3 minutes" />
        </div>

        <!-- Enquiry Modal -->
        @if (_showEnquiryModal)
        {
            <div class="modal-backdrop" @onclick="CloseEnquiry">
                <div class="modal-content" @onclick:stopPropagation>
                    <h3>Ask the owner a question</h3>
                    <p>Direct message — no agent middleman, no spam list.</p>
                    <div class="form-group">
                        <label>Your name</label>
                        <input type="text" @bind="_enqName" placeholder="Sienna Brooks" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" @bind="_enqEmail" placeholder="you@example.com" />
                    </div>
                    <div class="form-group">
                        <label>Question</label>
                        <textarea @bind="_enqMessage" placeholder="Is the rear deck staying? When can I inspect?"></textarea>
                    </div>
                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitEnquiry">Send question</button>
                        <button class="secondary-btn" @onclick="CloseEnquiry">Cancel</button>
                    </div>
                </div>
            </div>
        }

        <!-- Inspection Modal -->
        @if (_showInspectionModal)
        {
            <div class="modal-backdrop" @onclick="CloseInspection">
                <div class="modal-content" @onclick:stopPropagation>
                    <h3>Book an inspection</h3>
                    <p>Pick a slot. Owner confirms by reply.</p>
                    <div class="form-group">
                        <label>Your name</label>
                        <input type="text" @bind="_inspName" placeholder="Sienna Brooks" />
                    </div>
                    <div class="form-group">
                        <label>Phone (so the owner can reach you fast)</label>
                        <input type="tel" @bind="_inspPhone" placeholder="04xx xxx xxx" />
                    </div>
                    <div class="form-group">
                        <label>Preferred slot</label>
                        <div class="slot-grid">
                            @foreach (var slot in _inspectionSlots)
                            {
                                var s = slot;
                                <button type="button" class="slot @(_inspSlot == s ? "selected" : "")" @onclick="() => _inspSlot = s">@s</button>
                            }
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitInspection" disabled="@(string.IsNullOrEmpty(_inspSlot))">Request slot</button>
                        <button class="secondary-btn" @onclick="CloseInspection">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (_toast is not null)
        {
            <div class="page-toast" role="status">@_toast</div>
        }

        <!-- Offer Modal -->
        @if (_showOfferModal)
        {
            <div class="modal-backdrop">
                <div class="modal-content">
                    <h3>Make an Offer</h3>
                    <p>Submit your offer to the owner.</p>
                    
                    <div class="form-group">
                        <label>Your Offer Price ($)</label>
                        <input type="number" @bind="_offerPrice" placeholder="e.g. 1200000" />
                    </div>
                    
                    <div class="form-group">
                        <label>Your Name</label>
                        <input type="text" @bind="_offerName" placeholder="John Doe" />
                    </div>
                    
                    <div class="form-group">
                        <label>Message (Optional)</label>
                        <textarea @bind="_offerMessage" placeholder="I love this property because..."></textarea>
                    </div>

                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitOffer">Submit Offer</button>
                        <button class="secondary-btn" @onclick="() => _showOfferModal = false">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .property-page {
        font-family: 'Inter', sans-serif;
        background: #f8fafc;
        min-height: 100vh;
    }

    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.6)), url('/images/property-hero.jpg');
        background-size: cover;
        background-position: center;
        height: 60vh;
        display: flex;
        align-items: flex-end;
        padding: 40px;
        color: white;
    }

    .hero-content {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 10px 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .suburb {
        font-size: 1.5rem;
        opacity: 0.9;
    }

    .status-badge {
        background: #10b981;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .price-tag {
        font-size: 2rem;
        font-weight: 700;
        margin-top: 10px;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 40px;
        max-width: 1200px;
        margin: -60px auto 40px;
        padding: 0 20px;
        position: relative;
    }

    .main-details {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .key-features {
        display: flex;
        justify-content: space-between;
        padding-bottom: 30px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 30px;
    }

    .feature {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }

    .feature .icon { font-size: 24px; }
    .feature .value { font-weight: 700; font-size: 18px; color: #1f2937; }
    .feature .label { font-size: 14px; color: #6b7280; }

    .description-section h2, .description-section h3 {
        color: #111827;
        margin-top: 0;
    }

    .features-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .action-card {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        position: sticky;
        top: 20px;
    }

    .primary-btn {
        width: 100%;
        padding: 16px;
        background: #10b981;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: 16px;
        cursor: pointer;
        margin-bottom: 12px;
        transition: transform 0.2s;
    }

    .primary-btn:hover {
        background: #059669;
        transform: translateY(-2px);
    }

    .secondary-btn {
        width: 100%;
        padding: 14px;
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .agent-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #f3f4f6;
    }

    .avatar {
        width: 40px;
        height: 40px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .details {
        display: flex;
        flex-direction: column;
    }

    .details .name { font-weight: 600; color: #1f2937; font-size: 14px; }
    .details .role { color: #6b7280; font-size: 12px; }

    /* Modal Styles */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 16px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #374151;
    }

    .form-group input, .form-group textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-family: inherit;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .status-row {
        margin-top: 14px;
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.85);
        color: white;
        backdrop-filter: blur(8px);
    }
    .status-pill.open {
        background: rgba(16, 185, 129, 0.92);
    }

    .activity-strip {
        max-width: 1200px;
        margin: -24px auto 0 auto;
        padding: 14px 22px;
        background: white;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 5;
        flex-wrap: wrap;
    }
    .activity-pulse {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #10b981;
        position: relative;
        flex-shrink: 0;
    }
    .activity-pulse::after {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        background: #10b981;
        opacity: 0.4;
        animation: pulse-ring 1.6s ease-out infinite;
    }
    @@keyframes pulse-ring {
        0%   { transform: scale(0.5); opacity: 0.6; }
        100% { transform: scale(1.8); opacity: 0; }
    }
    .activity-stat {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
    }
    .activity-stat strong {
        font-size: 18px;
        font-weight: 800;
        color: #1a1a2e;
    }
    .activity-stat span {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
    }
    .activity-meta {
        margin-left: auto;
        font-size: 12px;
        color: #6b7280;
        font-style: italic;
    }

    .ghost-btn {
        background: none;
        border: 1px dashed rgba(99, 102, 241, 0.45);
        color: #6366f1;
        border-radius: 10px;
        padding: 11px 16px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-top: 10px;
        width: 100%;
        transition: background 0.15s, border-color 0.15s;
    }
    .ghost-btn:hover {
        background: rgba(99, 102, 241, 0.06);
        border-color: #6366f1;
        border-style: solid;
    }

    .slot-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .slot {
        background: white;
        border: 1.5px solid rgba(0, 0, 0, 0.08);
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 13px;
        font-weight: 700;
        color: #1a1a2e;
        cursor: pointer;
        font-family: inherit;
        transition: border-color .15s, background .15s;
    }
    .slot:hover { border-color: #6366f1; }
    .slot.selected {
        border-color: #6366f1;
        background: #ede9fe;
        color: #5b21b6;
    }

    .page-toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: #1a1a2e;
        color: white;
        padding: 12px 22px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.25);
        z-index: 1100;
        animation: pd-toast-in .25s ease;
    }
    @@keyframes pd-toast-in {
        from { opacity: 0; transform: translate(-50%, 12px); }
        to   { opacity: 1; transform: translate(-50%, 0); }
    }

    .sell-promo-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 24px 56px 24px;
    }

    @@media (max-width: 768px) {
        .content-grid {
            grid-template-columns: 1fr;
            margin-top: 0;
        }
        .hero-section {
            height: 40vh;
        }
        .sell-promo-wrap {
            padding: 12px 16px 40px 16px;
        }
        .activity-strip {
            margin: -8px 16px 0 16px;
            padding: 12px 16px;
        }
        .activity-meta { display: none; }
        .activity-stat strong { font-size: 16px; }
    }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Listing? _listing;
    private bool _showOfferModal = false;
    private decimal? _offerPrice;
    private string _offerName = "";
    private string _offerMessage = "";

    // Enquiry + inspection state
    private bool _showEnquiryModal;
    private string _enqName = "";
    private string _enqEmail = "";
    private string _enqMessage = "";

    private bool _showInspectionModal;
    private string _inspName = "";
    private string _inspPhone = "";
    private string _inspSlot = "";
    private readonly string[] _inspectionSlots = new[]
    {
        "Sat 10:00 am", "Sat 11:30 am", "Sat 1:00 pm",
        "Sun 10:00 am", "Sun 11:30 am",
        "Wed 5:30 pm"
    };

    private string? _toast;

    // Live activity counters — mock for now; back with telemetry in a follow-up.
    private int _viewersToday = 47;
    private int _enquiriesToday = 3;
    private int _offersTotal = 5;
    private int _savedCount = 18;
    private string _lastEnquiryAgo = "12 min";

    protected override async Task OnInitializedAsync()
    {
        _listing = await ListingService.GetListingAsync(Id);
    }

    private void MakeOffer()
    {
        _showOfferModal = true;
    }

    private void OpenEnquiry() => _showEnquiryModal = true;
    private void CloseEnquiry() => _showEnquiryModal = false;
    private void OpenInspection() => _showInspectionModal = true;
    private void CloseInspection() => _showInspectionModal = false;

    private void SubmitEnquiry()
    {
        if (string.IsNullOrWhiteSpace(_enqMessage)) return;
        _enquiriesToday += 1;
        _lastEnquiryAgo = "just now";
        _showEnquiryModal = false;
        Toast($"✓ Question sent to the owner. They'll reply by email.");
        _enqMessage = "";
    }

    private void SubmitInspection()
    {
        if (string.IsNullOrEmpty(_inspSlot)) return;
        _showInspectionModal = false;
        Toast($"✓ Inspection request sent for {_inspSlot}. Owner confirms by reply.");
        _inspSlot = "";
    }

    private void Toast(string message)
    {
        _toast = message;
        _ = HideToastSoon();
    }

    private async Task HideToastSoon()
    {
        await Task.Delay(3500);
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitOffer()
    {
        if (_listing == null || !_offerPrice.HasValue) return;

        // Create inquiry/offer
        var inquiry = new ListingInquiry
        {
             Id = Guid.NewGuid(),
             ListingId = _listing.Id,
             Message = $"OFFER: ${_offerPrice:N0} - {_offerMessage} (by {_offerName})",
             Status = InquiryStatus.OfferMade,
             CreatedAt = DateTime.UtcNow,
             Agent = new Aigents.Domain.Entities.Agent { Name = _offerName } // Hacky way to store sender name for now
        };

        _listing.Inquiries.Add(inquiry);
        await ListingService.UpdateListingAsync(_listing);

        _showOfferModal = false;
        // Optionally show success message
    }
}
