@page "/property/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: true))
@using Aigents.Web.Services
@using Aigents.Domain.Entities
@using Aigents.Infrastructure.Growth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Mail
@using System.Security.Claims
@using System.Text.Json
@inject IListingService ListingService
@inject IProductEventRecorder ProductEvents
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration

<PageTitle>@(_listing is null ? "Property | unrealestate.au" : $"{_listing.Headline} | unrealestate.au")</PageTitle>

@if (_listing is not null)
{
    <HeadContent>
        <meta name="description" content="@MetaDescription" />
        <link rel="canonical" href="@CanonicalUrl" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="unrealestate.au" />
        <meta property="og:title" content="@_listing.Headline" />
        <meta property="og:description" content="@MetaDescription" />
        <meta property="og:url" content="@CanonicalUrl" />
        @if (OpenGraphImageUrl is { } socialImage)
        {
            <meta property="og:image" content="@socialImage" />
            <meta name="twitter:image" content="@socialImage" />
        }
        <meta name="twitter:card" content="@(OpenGraphImageUrl is null ? "summary" : "summary_large_image")" />
        <meta name="twitter:title" content="@_listing.Headline" />
        <meta name="twitter:description" content="@MetaDescription" />
    </HeadContent>
}
else if (!_loading)
{
    <HeadContent>
        <meta name="robots" content="noindex, nofollow" />
    </HeadContent>
}

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading property details...</p>
    </div>
}
else if (_listing == null)
{
    <div class="loading-state">
        <h1>Property not found</h1>
        <p>This listing is unavailable or is no longer active.</p>
        <a href="/explore">Explore available properties</a>
    </div>
}
else
{
    <div class="property-page">
        <!-- Hero Section -->
        <div class="hero-section">
            <div class="hero-content">
                <span class="status-badge">@_listing.Status</span>
                <h1>@_listing.Address</h1>
                <p class="suburb">@_listing.Suburb, @_listing.State @_listing.Postcode</p>
                <div class="price-tag">
                    @_listing.PriceDisplay
                </div>
                <div class="status-row">
                    <span class="status-pill open">OPEN listing · any agent can sell it</span>
                </div>
            </div>
        </div>

        <!-- Real activity only: never manufacture social proof. -->
        @if (_activity is not null)
        {
            <div class="activity-strip">
                <div class="activity-pulse" aria-hidden="true"></div>
                <div class="activity-stat"><strong>@_activity.AuthenticatedViewsLast24Hours</strong><span>signed-in views (24h)</span></div>
                <div class="activity-stat"><strong>@_activity.EnquiriesLast24Hours</strong><span>enquiries (24h)</span></div>
                <div class="activity-stat"><strong>@_activity.OffersTotal</strong><span>offers received</span></div>
                @if (_activity.LastEnquiryAt is not null)
                {
                    <div class="activity-meta">Last enquiry @FormatRelativeTime(_activity.LastEnquiryAt.Value) ago</div>
                }
            </div>
        }

        <!-- Main Content -->
        <div class="content-grid">
            <!-- Left Column: Details -->
            <div class="main-details">
                <div class="key-features">
                    <div class="feature">
                        <span class="icon">🛏</span>
                        <span class="value">@_listing.Bedrooms</span>
                        <span class="label">Bed</span>
                    </div>
                    <div class="feature">
                        <span class="icon">🛁</span>
                        <span class="value">@_listing.Bathrooms</span>
                        <span class="label">Bath</span>
                    </div>
                    <div class="feature">
                        <span class="icon">🚗</span>
                        <span class="value">@_listing.CarSpaces</span>
                        <span class="label">Car</span>
                    </div>
                    <div class="feature">
                        <span class="icon">📐</span>
                        <span class="value">@(_listing.LandSize.HasValue ? _listing.LandSize + " m²" : "Large Block")</span>
                        <span class="label">Land</span>
                    </div>
                </div>

                <div class="description-section">
                    <h2>About this property</h2>
                    <p>@_listing.Description</p>
                    
                    <h3>Property Features</h3>
                    <ul class="features-list">
                        <li>Premium Location</li>
                        <li>Modern Design</li>
                        <li>Spacious Living Areas</li>
                        <li>Close to Transport</li>
                    </ul>
                </div>
            </div>

            <!-- Right Column: Action Card -->
            <div class="action-sidebar">
                <div class="action-card">
                    <h3>Interested?</h3>
                    <p>Make an offer or enquire directly with the owner.</p>
                    
                    <button class="primary-btn pulse" @onclick="MakeOffer">
                        Make an Offer
                    </button>

                    <button class="secondary-btn" @onclick="OpenEnquiry">
                        Ask a question
                    </button>

                    <button class="ghost-btn" @onclick="OpenInspection">
                        Book inspection
                    </button>

                    <button class="ghost-btn" @onclick="ChatAboutProperty">
                        Chat about this property
                    </button>

                    <div class="agent-profile">
                        <div class="avatar">H</div>
                        <div class="details">
                            <span class="name">Direct to Homeowner</span>
                            <span class="role">No agent fee · powered by unreal.estate</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sell-side promo: convert browsing buyers into sellers -->
        <div class="sell-promo-wrap">
            <SellPromoBanner Headline="Selling too? List your own home free in 3 minutes."
                             Sub="No marketing tax, no $3,000 cheque to a US portal. Drop your address, snap your photos — our AI writes the copy and stages the photos in seconds. Drag the slider to see it."
                             Meta="Australian-owned · not-for-profit · ~3 minutes" />
        </div>

        <!-- Enquiry Modal -->
        @if (_showEnquiryModal)
        {
            <div class="modal-backdrop" @onclick="CloseEnquiry">
                <div class="modal-content" @onclick:stopPropagation>
                    <h3>Ask the owner a question</h3>
                    <p>Direct message — no agent middleman, no spam list.</p>
                    <div class="form-group">
                        <label>Your name</label>
                        <input type="text" @bind="_enqName" maxlength="255" placeholder="Sienna Brooks" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" @bind="_enqEmail" maxlength="255" placeholder="you@example.com" />
                    </div>
                    <div class="form-group">
                        <label>Question</label>
                        <textarea @bind="_enqMessage" maxlength="2000" placeholder="Is the rear deck staying? When can I inspect?"></textarea>
                    </div>
                    @if (_formError is not null)
                    {
                        <p class="form-error" role="alert">@_formError</p>
                    }
                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitEnquiry">Send question</button>
                        <button class="secondary-btn" @onclick="CloseEnquiry">Cancel</button>
                    </div>
                </div>
            </div>
        }

        <!-- Inspection Modal -->
        @if (_showInspectionModal)
        {
            <div class="modal-backdrop" @onclick="CloseInspection">
                <div class="modal-content" @onclick:stopPropagation>
                    <h3>Book an inspection</h3>
                    <p>Pick a slot. Owner confirms by reply.</p>
                    <div class="form-group">
                        <label>Your name</label>
                        <input type="text" @bind="_inspName" maxlength="255" placeholder="Sienna Brooks" />
                    </div>
                    <div class="form-group">
                        <label>Phone (so the owner can reach you fast)</label>
                        <input type="tel" @bind="_inspPhone" maxlength="32" placeholder="04xx xxx xxx" />
                    </div>
                    @if (_formError is not null)
                    {
                        <p class="form-error" role="alert">@_formError</p>
                    }
                    <div class="form-group">
                        <label>Preferred slot</label>
                        <div class="slot-grid">
                            @foreach (var slot in _inspectionSlots)
                            {
                                var s = slot;
                                <button type="button" class="slot @(_inspSlot == s ? "selected" : "")" @onclick="() => _inspSlot = s">@s</button>
                            }
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitInspection" disabled="@(string.IsNullOrEmpty(_inspSlot))">Request slot</button>
                        <button class="secondary-btn" @onclick="CloseInspection">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (_toast is not null)
        {
            <div class="page-toast" role="status">@_toast</div>
        }

        <!-- Offer Modal -->
        @if (_showOfferModal)
        {
            <div class="modal-backdrop">
                <div class="modal-content">
                    <h3>Make an Offer</h3>
                    <p>Submit your offer to the owner.</p>
                    
                    <div class="form-group">
                        <label>Your Offer Price ($)</label>
                        <input type="number" min="1" step="1000" @bind="_offerPrice" placeholder="e.g. 1200000" />
                    </div>
                    
                    <div class="form-group">
                        <label>Your Name</label>
                        <input type="text" @bind="_offerName" maxlength="255" placeholder="John Doe" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" @bind="_offerEmail" maxlength="255" placeholder="you@example.com" />
                    </div>

                    <div class="form-group">
                        <label>Phone (optional if email supplied)</label>
                        <input type="tel" @bind="_offerPhone" maxlength="32" placeholder="04xx xxx xxx" />
                    </div>
                    
                    <div class="form-group">
                        <label>Message (Optional)</label>
                        <textarea @bind="_offerMessage" maxlength="1800" placeholder="I love this property because..."></textarea>
                    </div>
                    @if (_formError is not null)
                    {
                        <p class="form-error" role="alert">@_formError</p>
                    }

                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitOffer">Submit Offer</button>
                        <button class="secondary-btn" @onclick="() => _showOfferModal = false">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .property-page {
        font-family: 'Inter', sans-serif;
        background: #f8fafc;
        min-height: 100vh;
    }

    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.6)), url('/images/property-hero.jpg');
        background-size: cover;
        background-position: center;
        height: 60vh;
        display: flex;
        align-items: flex-end;
        padding: 40px;
        color: white;
    }

    .hero-content {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 10px 0;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .suburb {
        font-size: 1.5rem;
        opacity: 0.9;
    }

    .status-badge {
        background: #10b981;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .price-tag {
        font-size: 2rem;
        font-weight: 700;
        margin-top: 10px;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 40px;
        max-width: 1200px;
        margin: -60px auto 40px;
        padding: 0 20px;
        position: relative;
    }

    .main-details {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .key-features {
        display: flex;
        justify-content: space-between;
        padding-bottom: 30px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 30px;
    }

    .feature {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }

    .feature .icon { font-size: 24px; }
    .feature .value { font-weight: 700; font-size: 18px; color: #1f2937; }
    .feature .label { font-size: 14px; color: #6b7280; }

    .description-section h2, .description-section h3 {
        color: #111827;
        margin-top: 0;
    }

    .features-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .action-card {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        position: sticky;
        top: 20px;
    }

    .primary-btn {
        width: 100%;
        padding: 16px;
        background: #10b981;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: 16px;
        cursor: pointer;
        margin-bottom: 12px;
        transition: transform 0.2s;
    }

    .primary-btn:hover {
        background: #059669;
        transform: translateY(-2px);
    }

    .secondary-btn {
        width: 100%;
        padding: 14px;
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .agent-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #f3f4f6;
    }

    .avatar {
        width: 40px;
        height: 40px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .details {
        display: flex;
        flex-direction: column;
    }

    .details .name { font-weight: 600; color: #1f2937; font-size: 14px; }
    .details .role { color: #6b7280; font-size: 12px; }

    /* Modal Styles */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 16px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #374151;
    }

    .form-group input, .form-group textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-family: inherit;
    }

    .form-error {
        color: #b91c1c;
        font-size: 14px;
        margin: 0;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .status-row {
        margin-top: 14px;
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.85);
        color: white;
        backdrop-filter: blur(8px);
    }
    .status-pill.open {
        background: rgba(16, 185, 129, 0.92);
    }

    .activity-strip {
        max-width: 1200px;
        margin: -24px auto 0 auto;
        padding: 14px 22px;
        background: white;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 5;
        flex-wrap: wrap;
    }
    .activity-pulse {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #10b981;
        position: relative;
        flex-shrink: 0;
    }
    .activity-pulse::after {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        background: #10b981;
        opacity: 0.4;
        animation: pulse-ring 1.6s ease-out infinite;
    }
    @@keyframes pulse-ring {
        0%   { transform: scale(0.5); opacity: 0.6; }
        100% { transform: scale(1.8); opacity: 0; }
    }
    .activity-stat {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
    }
    .activity-stat strong {
        font-size: 18px;
        font-weight: 800;
        color: #1a1a2e;
    }
    .activity-stat span {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
    }
    .activity-meta {
        margin-left: auto;
        font-size: 12px;
        color: #6b7280;
        font-style: italic;
    }

    .ghost-btn {
        background: none;
        border: 1px dashed rgba(99, 102, 241, 0.45);
        color: #6366f1;
        border-radius: 10px;
        padding: 11px 16px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        margin-top: 10px;
        width: 100%;
        transition: background 0.15s, border-color 0.15s;
    }
    .ghost-btn:hover {
        background: rgba(99, 102, 241, 0.06);
        border-color: #6366f1;
        border-style: solid;
    }

    .slot-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .slot {
        background: white;
        border: 1.5px solid rgba(0, 0, 0, 0.08);
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 13px;
        font-weight: 700;
        color: #1a1a2e;
        cursor: pointer;
        font-family: inherit;
        transition: border-color .15s, background .15s;
    }
    .slot:hover { border-color: #6366f1; }
    .slot.selected {
        border-color: #6366f1;
        background: #ede9fe;
        color: #5b21b6;
    }

    .page-toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: #1a1a2e;
        color: white;
        padding: 12px 22px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.25);
        z-index: 1100;
        animation: pd-toast-in .25s ease;
    }
    @@keyframes pd-toast-in {
        from { opacity: 0; transform: translate(-50%, 12px); }
        to   { opacity: 1; transform: translate(-50%, 0); }
    }

    .sell-promo-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 24px 56px 24px;
    }

    @@media (max-width: 768px) {
        .content-grid {
            grid-template-columns: 1fr;
            margin-top: 0;
        }
        .hero-section {
            height: 40vh;
        }
        .sell-promo-wrap {
            padding: 12px 16px 40px 16px;
        }
        .activity-strip {
            margin: -8px 16px 0 16px;
            padding: 12px 16px;
        }
        .activity-meta { display: none; }
        .activity-stat strong { font-size: 16px; }
    }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Listing? _listing;
    private ListingActivity? _activity;
    private Guid _currentUserId;
    private bool _loading = true;
    private bool _showOfferModal = false;
    private decimal? _offerPrice;
    private string _offerName = "";
    private string _offerEmail = "";
    private string _offerPhone = "";
    private string _offerMessage = "";

    // Enquiry + inspection state
    private bool _showEnquiryModal;
    private string _enqName = "";
    private string _enqEmail = "";
    private string _enqMessage = "";

    private bool _showInspectionModal;
    private string _inspName = "";
    private string _inspPhone = "";
    private string _inspSlot = "";
    private readonly string[] _inspectionSlots = new[]
    {
        "Sat 10:00 am", "Sat 11:30 am", "Sat 1:00 pm",
        "Sun 10:00 am", "Sun 11:30 am",
        "Wed 5:30 pm"
    };

    private string? _toast;
    private string? _formError;

    private string PublicBaseUrl =>
        (Configuration["App:PublicUrl"] ?? "https://unrealestate.au").TrimEnd('/');

    private string CanonicalUrl => $"{PublicBaseUrl}/property/{Id}";

    private string MetaDescription
    {
        get
        {
            var description = _listing?.Description?.Trim();
            if (string.IsNullOrWhiteSpace(description))
            {
                description = $"{_listing?.PropertyType} for sale in {_listing?.Suburb}, {_listing?.State}.";
            }

            return description.Length <= 160
                ? description
                : $"{description[..157]}...";
        }
    }

    private string? OpenGraphImageUrl
    {
        get
        {
            if (_listing is not null)
            {
                try
                {
                    var imageUrls = JsonSerializer.Deserialize<List<string>>(_listing.ImageUrls);
                    var firstImage = imageUrls?.FirstOrDefault(url => !string.IsNullOrWhiteSpace(url));
                    if (firstImage is not null)
                    {
                        return Uri.TryCreate(firstImage, UriKind.Absolute, out var absolute)
                            ? absolute.ToString()
                            : new Uri(new Uri($"{PublicBaseUrl}/"), firstImage).ToString();
                    }
                }
                catch (JsonException)
                {
                    // Invalid legacy image JSON falls back to the site image.
                }
            }

            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _listing = await ListingService.GetPublicListingAsync(Id);
        if (_listing is null)
        {
            var response = HttpContextAccessor.HttpContext?.Response;
            if (response is not null && !response.HasStarted)
            {
                response.StatusCode = StatusCodes.Status404NotFound;
            }

            _loading = false;
            return;
        }

        _currentUserId = await GetAuthenticatedUserIdAsync();
        if (_currentUserId != Guid.Empty)
        {
            await ProductEvents.RecordAsync(
                _currentUserId,
                ProductEventNames.ListingViewed,
                _listing.Id,
                TimeSpan.FromMinutes(30));
        }

        await RefreshActivityAsync();
        _loading = false;
    }

    private void MakeOffer()
    {
        _formError = null;
        _showOfferModal = true;
    }

    private void OpenEnquiry()
    {
        _formError = null;
        _showEnquiryModal = true;
    }

    private void CloseEnquiry()
    {
        _formError = null;
        _showEnquiryModal = false;
    }

    private void OpenInspection()
    {
        _formError = null;
        _showInspectionModal = true;
    }

    private void CloseInspection()
    {
        _formError = null;
        _showInspectionModal = false;
    }

    private void ChatAboutProperty()
    {
        if (_listing is null)
        {
            return;
        }

        var chatUrl =
            $"/chat?mode=buy&address={Uri.EscapeDataString(_listing.Address)}";
        if (_currentUserId == Guid.Empty)
        {
            Navigation.NavigateTo(
                $"/Account/Login?returnUrl={Uri.EscapeDataString(chatUrl)}");
            return;
        }

        Navigation.NavigateTo(chatUrl);
    }

    private async Task SubmitEnquiry()
    {
        if (_listing is null) return;

        _formError = ValidateName(_enqName)
            ?? ValidateEmail(_enqEmail)
            ?? (string.IsNullOrWhiteSpace(_enqMessage)
                ? "Enter a question for the owner."
                : null);
        if (_formError is not null) return;

        var inquiry = new ListingInquiry
        {
            Message = _enqMessage.Trim(),
            BuyerName = NullIfWhiteSpace(_enqName),
            BuyerEmail = NullIfWhiteSpace(_enqEmail),
            InquiryType = BuyerInquiryType.Question,
            Status = InquiryStatus.New,
        };
        try
        {
            await ListingService.CreateInquiryAsync(_listing.Id, inquiry);
        }
        catch (Exception ex)
            when (ex is ArgumentException or InvalidOperationException)
        {
            _formError = ex.Message;
            return;
        }
        await RecordCurrentUserEventAsync(ProductEventNames.EnquirySubmitted);
        await RefreshActivityAsync();

        _showEnquiryModal = false;
        _formError = null;
        Toast("✓ Question sent to the owner. They'll reply by email.");
        _enqMessage = "";
    }

    private async Task SubmitInspection()
    {
        if (_listing is null) return;

        _formError = ValidateName(_inspName)
            ?? ValidatePhone(_inspPhone)
            ?? (string.IsNullOrWhiteSpace(_inspSlot)
                ? "Choose a preferred inspection slot."
                : null);
        if (_formError is not null) return;

        var inquiry = new ListingInquiry
        {
            Message = $"Requested slot: {_inspSlot}",
            BuyerName = NullIfWhiteSpace(_inspName),
            BuyerPhone = NullIfWhiteSpace(_inspPhone),
            InquiryType = BuyerInquiryType.Inspection,
            Status = InquiryStatus.InspectionBooked,
        };
        try
        {
            await ListingService.CreateInquiryAsync(_listing.Id, inquiry);
        }
        catch (Exception ex)
            when (ex is ArgumentException or InvalidOperationException)
        {
            _formError = ex.Message;
            return;
        }
        await RecordCurrentUserEventAsync(ProductEventNames.InspectionBooked);
        await RefreshActivityAsync();

        _showInspectionModal = false;
        _formError = null;
        Toast($"✓ Inspection request sent for {_inspSlot}. Owner confirms by reply.");
        _inspSlot = "";
    }

    private void Toast(string message)
    {
        _toast = message;
        _ = HideToastSoon();
    }

    private async Task HideToastSoon()
    {
        await Task.Delay(3500);
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitOffer()
    {
        if (_listing is null) return;

        _formError = ValidateName(_offerName)
            ?? (_offerPrice is null or <= 0
                ? "Enter an offer amount greater than zero."
                : null)
            ?? ValidateReplyChannel(_offerEmail, _offerPhone);
        if (_formError is not null) return;

        var inquiry = new ListingInquiry
        {
            Message = $"Offer: ${_offerPrice:N0}"
                + (string.IsNullOrWhiteSpace(_offerMessage) ? "" : $" — {_offerMessage.Trim()}"),
            BuyerName = NullIfWhiteSpace(_offerName),
            BuyerEmail = NullIfWhiteSpace(_offerEmail),
            BuyerPhone = NullIfWhiteSpace(_offerPhone),
            OfferAmount = _offerPrice,
            InquiryType = BuyerInquiryType.Offer,
            Status = InquiryStatus.OfferMade,
        };

        try
        {
            await ListingService.CreateInquiryAsync(_listing.Id, inquiry);
        }
        catch (Exception ex)
            when (ex is ArgumentException or InvalidOperationException)
        {
            _formError = ex.Message;
            return;
        }
        await RecordCurrentUserEventAsync(ProductEventNames.OfferSubmitted);
        await RefreshActivityAsync();

        _showOfferModal = false;
        _formError = null;
        Toast("✓ Offer sent to the owner.");
    }

    private static string? ValidateName(string value) =>
        string.IsNullOrWhiteSpace(value) || value.Trim().Length < 2
            ? "Enter your name."
            : value.Trim().Length > 255
                ? "Name must be 255 characters or fewer."
                : null;

    private static string? ValidateEmail(string value)
    {
        var email = value.Trim();
        return MailAddress.TryCreate(email, out var address)
            && address.Address.Equals(email, StringComparison.OrdinalIgnoreCase)
                ? null
                : "Enter a valid email address.";
    }

    private static string? ValidatePhone(string value)
    {
        var phone = value.Trim();
        var digitCount = phone.Count(char.IsDigit);
        var validCharacters = phone.All(character =>
            char.IsDigit(character)
            || char.IsWhiteSpace(character)
            || character is '+' or '-' or '(' or ')' or '.');
        return phone.Length <= 32
            && digitCount is >= 8 and <= 15
            && validCharacters
            ? null
            : "Enter a valid phone number.";
    }

    private static string? ValidateReplyChannel(
        string emailValue,
        string phoneValue)
    {
        var hasEmail = !string.IsNullOrWhiteSpace(emailValue);
        var hasPhone = !string.IsNullOrWhiteSpace(phoneValue);
        if (!hasEmail && !hasPhone)
            return "Enter an email address or phone number.";

        if (hasEmail && ValidateEmail(emailValue) is { } emailError)
            return emailError;
        if (hasPhone && ValidatePhone(phoneValue) is { } phoneError)
            return phoneError;

        return null;
    }

    private async Task<Guid> GetAuthenticatedUserIdAsync()
    {
        if (AuthState is null)
        {
            return Guid.Empty;
        }

        var principal = (await AuthState).User;
        return principal.Identity?.IsAuthenticated == true
            && Guid.TryParse(
                principal.FindFirst(ClaimTypes.NameIdentifier)?.Value,
                out var userId)
            ? userId
            : Guid.Empty;
    }

    private async Task RecordCurrentUserEventAsync(string eventName)
    {
        if (_currentUserId != Guid.Empty && _listing is not null)
        {
            await ProductEvents.RecordAsync(
                _currentUserId,
                eventName,
                _listing.Id);
        }
    }

    private async Task RefreshActivityAsync()
    {
        if (_listing is not null)
        {
            _activity = await ProductEvents.GetListingActivityAsync(_listing.Id);
        }
    }

    private static string? NullIfWhiteSpace(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatRelativeTime(DateTime timestamp)
    {
        var elapsed = DateTime.UtcNow - timestamp.ToUniversalTime();
        if (elapsed < TimeSpan.FromMinutes(1)) return "just now";
        if (elapsed < TimeSpan.FromHours(1)) return $"{Math.Max(1, (int)elapsed.TotalMinutes)} min";
        if (elapsed < TimeSpan.FromDays(1)) return $"{Math.Max(1, (int)elapsed.TotalHours)} hr";
        return $"{Math.Max(1, (int)elapsed.TotalDays)} d";
    }
}
