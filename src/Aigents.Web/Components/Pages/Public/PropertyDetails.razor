@page "/property/{Id:guid}"
@using Aigents.Web.Services
@using Aigents.Domain.Entities
@inject IListingService ListingService
@inject NavigationManager Navigation

<PageTitle>@(_listing is not null ? $"{_listing.Address} | unrealestate.au" : "Property unavailable | unrealestate.au")</PageTitle>

@if (!_loaded)
{
    <div class="loading-state" data-testid="property-loading">
        <div class="spinner"></div>
        <p>Loading property details...</p>
    </div>
}
else if (_listing == null)
{
    <div class="unavailable-state" data-testid="property-not-found">
        <h1>Property unavailable</h1>
        <p>This listing is not published or could not be found. Draft, withdrawn, and off-market properties are not publicly accessible.</p>
        <div class="unavailable-actions">
            <a class="primary-link" href="/buyer/matches">Back to buyer matches</a>
            <a class="secondary-link" href="/buy">Browse published listings</a>
        </div>
    </div>
}
else
{
    <div class="property-page" data-testid="property-details-page">
        <!-- Hero Section -->
        <div class="hero-section">
            <div class="hero-content">
                <span class="status-badge">Published</span>
                <h1>@_listing.Address</h1>
                <p class="suburb">@_listing.Suburb, @_listing.State @_listing.Postcode</p>
                <div class="price-tag">
                    @_listing.PriceDisplay
                </div>
                <div class="status-row">
                    <span class="status-pill open">OPEN listing · any licensed agent can introduce a buyer</span>
                </div>
            </div>
        </div>

        <!-- Verifiable listing facts strip (no fabricated urgency counters) -->
        <div class="facts-strip" data-testid="property-verifiable-facts">
            <div class="fact-item"><strong>Published</strong><span>Status</span></div>
            <div class="fact-item"><strong>@(string.IsNullOrWhiteSpace(_listing.PropertyType) ? "Unspecified" : _listing.PropertyType)</strong><span>Property type</span></div>
            <div class="fact-item"><strong>@_listing.Suburb @(_listing.Postcode)</strong><span>Location</span></div>
            <div class="fact-item"><strong>@((_listing.PublishedAt ?? _listing.CreatedAt).ToString("dd MMM yyyy"))</strong><span>Listed date</span></div>
        </div>

        <!-- Main Content -->
        <div class="content-grid">
            <!-- Left Column: Details -->
            <div class="main-details">
                <div class="key-features">
                    <div class="feature">
                        <span class="icon">🛏</span>
                        <span class="value">@(_listing.Bedrooms?.ToString() ?? "—")</span>
                        <span class="label">Bed</span>
                    </div>
                    <div class="feature">
                        <span class="icon">🛁</span>
                        <span class="value">@(_listing.Bathrooms?.ToString() ?? "—")</span>
                        <span class="label">Bath</span>
                    </div>
                    <div class="feature">
                        <span class="icon">🚗</span>
                        <span class="value">@(_listing.CarSpaces?.ToString() ?? "—")</span>
                        <span class="label">Car</span>
                    </div>
                    <div class="feature">
                        <span class="icon">📐</span>
                        <span class="value">@(_listing.LandSize.HasValue ? _listing.LandSize + " m²" : "Not stated")</span>
                        <span class="label">Land</span>
                    </div>
                </div>

                <div class="description-section">
                    <h2>About this property</h2>
                    <p>@(string.IsNullOrWhiteSpace(_listing.Description) ? "No additional description has been supplied for this listing yet." : _listing.Description)</p>

                    @if (_listing.Features.Length > 0)
                    {
                        <h3>Supplied Property Features</h3>
                        <ul class="features-list">
                            @foreach (var feat in _listing.Features)
                            {
                                <li>@feat</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- Right Column: Action Card -->
            <div class="action-sidebar">
                <div class="action-card">
                    <h3>Interested?</h3>
                    <p>Make an offer or enquire regarding this published property.</p>

                    <button class="primary-btn" @onclick="MakeOffer">
                        Make an Offer
                    </button>

                    <button class="secondary-btn" @onclick="OpenEnquiry">
                        Ask a question
                    </button>

                    <button class="ghost-btn" @onclick="OpenInspection">
                        Book inspection
                    </button>

                    <div class="agent-profile">
                        <div class="avatar">L</div>
                        <div class="details">
                            <span class="name">Listing Contact</span>
                            <span class="role">Enquiries routed to the listing representative</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sell-side promo: convert browsing buyers into sellers -->
        <div class="sell-promo-wrap">
            <SellPromoBanner Headline="Selling too? List your own home free in 3 minutes."
                             Sub="No marketing tax, no $3,000 cheque to a US portal. Drop your address, snap your photos — our AI writes the copy and stages the photos in seconds. Drag the slider to see it."
                             Meta="Australian-owned · not-for-profit · ~3 minutes" />
        </div>

        <!-- Enquiry Modal -->
        @if (_showEnquiryModal)
        {
            <div class="modal-backdrop" @onclick="CloseEnquiry">
                <div class="modal-content" @onclick:stopPropagation>
                    <h3>Ask a question</h3>
                    <p>Send your question regarding this property.</p>
                    <div class="form-group">
                        <label>Your name</label>
                        <input type="text" @bind="_enqName" placeholder="Sienna Brooks" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" @bind="_enqEmail" placeholder="you@example.com" />
                    </div>
                    <div class="form-group">
                        <label>Question</label>
                        <textarea @bind="_enqMessage" placeholder="Is the rear deck staying? When can I inspect?"></textarea>
                    </div>
                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitEnquiry">Send question</button>
                        <button class="secondary-btn" @onclick="CloseEnquiry">Cancel</button>
                    </div>
                </div>
            </div>
        }

        <!-- Inspection Modal -->
        @if (_showInspectionModal)
        {
            <div class="modal-backdrop" @onclick="CloseInspection">
                <div class="modal-content" @onclick:stopPropagation>
                    <h3>Book an inspection</h3>
                    <p>Pick a preferred inspection window.</p>
                    <div class="form-group">
                        <label>Your name</label>
                        <input type="text" @bind="_inspName" placeholder="Sienna Brooks" />
                    </div>
                    <div class="form-group">
                        <label>Phone</label>
                        <input type="tel" @bind="_inspPhone" placeholder="04xx xxx xxx" />
                    </div>
                    <div class="form-group">
                        <label>Preferred slot</label>
                        <div class="slot-grid">
                            @foreach (var slot in _inspectionSlots)
                            {
                                var s = slot;
                                <button type="button" class="slot @(_inspSlot == s ? "selected" : "")" @onclick="() => _inspSlot = s">@s</button>
                            }
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitInspection" disabled="@(string.IsNullOrEmpty(_inspSlot))">Request slot</button>
                        <button class="secondary-btn" @onclick="CloseInspection">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (_toast is not null)
        {
            <div class="page-toast" role="status">@_toast</div>
        }

        <!-- Offer Modal -->
        @if (_showOfferModal)
        {
            <div class="modal-backdrop">
                <div class="modal-content">
                    <h3>Make an Offer</h3>
                    <p>Submit your offer for this property.</p>

                    <div class="form-group">
                        <label>Your Offer Price ($)</label>
                        <input type="number" @bind="_offerPrice" placeholder="e.g. 1200000" />
                    </div>

                    <div class="form-group">
                        <label>Your Name</label>
                        <input type="text" @bind="_offerName" placeholder="John Doe" />
                    </div>

                    <div class="form-group">
                        <label>Message (Optional)</label>
                        <textarea @bind="_offerMessage" placeholder="Any conditions or settlement terms..."></textarea>
                    </div>

                    <div class="modal-actions">
                        <button class="primary-btn" @onclick="SubmitOffer">Submit Offer</button>
                        <button class="secondary-btn" @onclick="() => _showOfferModal = false">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .property-page {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f8fafc;
        min-height: 100vh;
    }

    .unavailable-state {
        max-width: 640px;
        margin: 80px auto;
        padding: 32px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        text-align: center;
    }

    .unavailable-state h1 {
        font-size: 1.8rem;
        color: #0f172a;
        margin: 0 0 12px;
    }

    .unavailable-state p {
        color: #475569;
        margin: 0 0 24px;
        line-height: 1.6;
    }

    .unavailable-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .primary-link {
        padding: 10px 16px;
        border-radius: 8px;
        background: #0f766e;
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
    }

    .secondary-link {
        padding: 10px 16px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        color: #334155;
        font-weight: 600;
        text-decoration: none;
    }

    .hero-section {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        min-height: 36vh;
        display: flex;
        align-items: flex-end;
        padding: 40px;
        color: white;
    }

    .hero-content {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    h1 {
        font-size: 2.6rem;
        font-weight: 800;
        margin: 10px 0;
    }

    .suburb {
        font-size: 1.35rem;
        opacity: 0.9;
    }

    .status-badge {
        background: #10b981;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .price-tag {
        font-size: 2rem;
        font-weight: 700;
        margin-top: 16px;
        color: #fbbf24;
    }

    .content-grid {
        max-width: 1200px;
        margin: 24px auto 0;
        padding: 0 24px 32px;
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 32px;
    }

    .main-details, .action-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .key-features {
        display: flex;
        justify-content: space-around;
        padding-bottom: 24px;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 24px;
    }

    .feature {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .feature .icon { font-size: 1.5rem; }
    .feature .value { font-size: 1.25rem; font-weight: 700; color: #1e293b; }
    .feature .label { font-size: 0.875rem; color: #64748b; }

    .description-section h2 { font-size: 1.5rem; color: #1e293b; margin-bottom: 16px; }
    .description-section p { line-height: 1.7; color: #475569; margin-bottom: 24px; }

    .features-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding-left: 20px;
        color: #475569;
    }

    .action-card { position: sticky; top: 24px; }
    .action-card h3 { font-size: 1.4rem; margin-bottom: 8px; }
    .action-card p { color: #64748b; margin-bottom: 20px; }

    .primary-btn, .secondary-btn {
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        margin-bottom: 12px;
        border: none;
    }

    .primary-btn { background: #10b981; color: white; }
    .secondary-btn { background: #f1f5f9; color: #334155; }

    .agent-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .avatar {
        width: 44px;
        height: 44px;
        background: #0f766e;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .details { display: flex; flex-direction: column; }
    .details .name { font-weight: 600; color: #1e293b; }
    .details .role { font-size: 0.85rem; color: #64748b; }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        padding: 28px;
        border-radius: 16px;
        width: 100%;
        max-width: 480px;
    }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 600; }
    .form-group input, .form-group textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
    }

    .modal-actions { display: flex; gap: 12px; margin-top: 20px; }

    .status-row { margin-top: 12px; }
    .status-pill.open {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        background: rgba(16, 185, 129, 0.22);
        border: 1px solid rgba(16, 185, 129, 0.55);
        color: #ecfdf5;
    }

    .facts-strip {
        max-width: 1200px;
        margin: 20px auto 0;
        padding: 14px 24px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
    }
    .fact-item { display: flex; flex-direction: column; gap: 2px; }
    .fact-item strong { font-size: 1rem; font-weight: 700; color: #0f172a; }
    .fact-item span { font-size: 0.78rem; color: #64748b; }

    .ghost-btn {
        width: 100%;
        padding: 12px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        background: transparent;
        color: #0f172a;
        border: 1px dashed #cbd5e1;
    }

    .slot-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }
    .slot {
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        background: #f8fafc;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
    }
    .slot.selected {
        background: #10b981;
        border-color: #10b981;
        color: #ffffff;
    }

    .page-toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: #0f172a;
        color: #ffffff;
        padding: 14px 20px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        z-index: 1100;
    }

    .sell-promo-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 24px 56px 24px;
    }

    @@media (max-width: 768px) {
        .content-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Listing? _listing;
    private bool _loaded;
    private bool _showOfferModal;
    private decimal? _offerPrice;
    private string _offerName = "";
    private string _offerMessage = "";

    private bool _showEnquiryModal;
    private string _enqName = "";
    private string _enqEmail = "";
    private string _enqMessage = "";

    private bool _showInspectionModal;
    private string _inspName = "";
    private string _inspPhone = "";
    private string _inspSlot = "";
    private readonly string[] _inspectionSlots =
    [
        "Sat 10:00 am", "Sat 11:30 am", "Sat 1:00 pm",
        "Sun 10:00 am", "Sun 11:30 am",
        "Wed 5:30 pm"
    ];

    private string? _toast;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _listing = await ListingService.GetPublishedListingByIdAsync(Id);
        _loaded = true;
    }

    private void MakeOffer() => _showOfferModal = true;
    private void OpenEnquiry() => _showEnquiryModal = true;
    private void CloseEnquiry() => _showEnquiryModal = false;
    private void OpenInspection() => _showInspectionModal = true;
    private void CloseInspection() => _showInspectionModal = false;

    private async Task SubmitEnquiry()
    {
        if (string.IsNullOrWhiteSpace(_enqMessage) || _listing is null) return;

        var inquiry = new ListingInquiry
        {
            Id = Guid.NewGuid(),
            ListingId = _listing.Id,
            Message = $"QUESTION: {_enqMessage} (from {_enqName} · {_enqEmail})",
            Status = InquiryStatus.New,
            CreatedAt = DateTime.UtcNow,
            Agent = new Aigents.Domain.Entities.Agent { Name = string.IsNullOrWhiteSpace(_enqName) ? "Anonymous buyer" : _enqName }
        };
        var ok = await ListingService.AddPublishedListingInquiryAsync(_listing.Id, inquiry);
        _showEnquiryModal = false;
        if (ok)
        {
            Toast("✓ Question recorded for the listing representative.");
            _enqMessage = "";
        }
        else
        {
            Toast("This property is no longer published.");
        }
    }

    private async Task SubmitInspection()
    {
        if (string.IsNullOrEmpty(_inspSlot) || _listing is null) return;

        var inquiry = new ListingInquiry
        {
            Id = Guid.NewGuid(),
            ListingId = _listing.Id,
            Message = $"INSPECTION: requested {_inspSlot} (from {_inspName} · {_inspPhone})",
            Status = InquiryStatus.InspectionBooked,
            CreatedAt = DateTime.UtcNow,
            Agent = new Aigents.Domain.Entities.Agent { Name = string.IsNullOrWhiteSpace(_inspName) ? "Anonymous buyer" : _inspName }
        };
        var ok = await ListingService.AddPublishedListingInquiryAsync(_listing.Id, inquiry);
        _showInspectionModal = false;
        if (ok)
        {
            Toast($"✓ Inspection request recorded for {_inspSlot}.");
            _inspSlot = "";
        }
        else
        {
            Toast("This property is no longer published.");
        }
    }

    private void Toast(string message)
    {
        _toast = message;
        _ = HideToastSoon();
    }

    private async Task HideToastSoon()
    {
        await Task.Delay(3500);
        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitOffer()
    {
        if (_listing == null || !_offerPrice.HasValue) return;

        var inquiry = new ListingInquiry
        {
            Id = Guid.NewGuid(),
            ListingId = _listing.Id,
            Message = $"OFFER: ${_offerPrice:N0} - {_offerMessage} (by {_offerName})",
            Status = InquiryStatus.OfferMade,
            CreatedAt = DateTime.UtcNow,
            Agent = new Aigents.Domain.Entities.Agent { Name = string.IsNullOrWhiteSpace(_offerName) ? "Anonymous buyer" : _offerName }
        };

        var ok = await ListingService.AddPublishedListingInquiryAsync(_listing.Id, inquiry);
        _showOfferModal = false;
        if (ok)
        {
            Toast("✓ Offer recorded for the listing representative.");
        }
    }
}
