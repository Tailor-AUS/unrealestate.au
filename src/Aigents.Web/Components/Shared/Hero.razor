@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Aigents.Domain.Entities
@using Aigents.Infrastructure.Services.Import
@using Aigents.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav
@inject IListingService ListingService
@inject IJSRuntime JS

<div class="ue-home" data-testid="liquid-glass-home">
    @* ─── Full-bleed Apple Liquid Glass Hero (strictly <= 3 elements) ─── *@
    <section class="ue-hero">
        <div class="ue-hero-photo" aria-hidden="true"></div>
        <div class="ue-hero-scrim" aria-hidden="true"></div>

        <div class="ue-hero-inner">
            @* Element 1: Headline *@
            <div class="ue-hero-copy">
                <span class="ue-nfp-pill">Not-for-profit · Australian-owned · Free forever</span>
                <h1 class="ue-hero-title">Australian homes. $0 to list.</h1>
                <p class="ue-hero-sub">
                    Search, match &amp; enquire with zero pay-to-rank clutter — or paste your agency listing link and auto-post for $0.
                </p>
            </div>

            @* Element 2: Refractive Liquid Glass Search / Buyer Brief / Agent Link Capsule *@
            <div class="ue-capsule-wrap">
                <div class="ue-mode-pills" role="tablist" aria-label="Search mode">
                    <button type="button" class="ue-mode-pill @(_mode == "buy" ? "active" : "")" @onclick='() => _mode = "buy"'>Buy</button>
                    <button type="button" class="ue-mode-pill @(_mode == "match" ? "active" : "")" @onclick='() => _mode = "match"'>AI Match</button>
                    <button type="button" class="ue-mode-pill @(_mode == "map" ? "active" : "")" @onclick='() => _mode = "map"'>Map</button>
                    <button type="button" class="ue-mode-pill @(_mode == "agentlink" ? "active" : "")" @onclick='() => _mode = "agentlink"'>Paste Agent Link</button>
                </div>

                <div class="ue-search-capsule lg-refract">
                    <span class="ue-search-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <circle cx="11" cy="11" r="7" />
                            <path d="M21 21l-4.35-4.35" stroke-linecap="round" />
                        </svg>
                    </span>
                    <input type="text"
                           class="ue-search-input"
                           data-testid="hero-search-input"
                           placeholder="@GetPlaceholder()"
                           @bind="_query"
                           @bind:event="oninput"
                           @onkeyup="HandleKeyup" />
                    <button type="button"
                            class="ue-search-go"
                            data-testid="hero-search-submit"
                            @onclick="HandleSearch">
                        <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M10 1.5l2.1 5.4 5.4 2.1-5.4 2.1L10 16.5l-2.1-5.4L2.5 9l5.4-2.1L10 1.5z" />
                        </svg>
                        <span>@(_mode == "agentlink" ? "Auto-Post" : "Match")</span>
                    </button>
                </div>
            </div>

            @* Element 3: Floating Liquid Glass Property Preview Cards over pool reflections *@
            <div class="ue-preview-strip" data-testid="hero-preview-cards">
                @if (_featured.Count > 0)
                {
                    @foreach (var item in _featured)
                    {
                        var l = item;
                        var isSaved = _savedIds.Contains(l.Id.ToString());
                        <article class="ue-glass-card lg-refract">
                            <a href="@($"/property/{l.Id}")" class="ue-card-thumb" aria-label="View @l.Address">
                                <img src="@ResolveCardImage(l)" alt="@l.Address" referrerpolicy="no-referrer" />
                            </a>
                            <div class="ue-card-body">
                                <div class="ue-card-top">
                                    <span class="ue-card-pill">$0 VPA · Free</span>
                                    <button type="button"
                                            class="ue-heart @(isSaved ? "saved" : "")"
                                            aria-label="@(isSaved ? "Remove from shortlist" : "Save to shortlist")"
                                            @onclick="() => ToggleSaveAsync(l)">
                                        @(isSaved ? "♥" : "♡")
                                    </button>
                                </div>
                                <a href="@($"/property/{l.Id}")" class="ue-card-price">@FormatPrice(l)</a>
                                <div class="ue-card-suburb">@l.Suburb @l.State @l.Postcode</div>
                                <div class="ue-card-specs">@FormatSpecs(l)</div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <a href="/buyer/matches" class="ue-glass-card ue-empty-card lg-refract">
                        <div class="ue-card-body">
                            <span class="ue-card-pill">For Buyers</span>
                            <div class="ue-card-price">Explainable AI Match</div>
                            <div class="ue-card-suburb">Ranked by your brief — never by who paid $4,000 for Premiere+.</div>
                        </div>
                    </a>
                    <a href="/agents#quick-link-post" class="ue-glass-card ue-empty-card lg-refract">
                        <div class="ue-card-body">
                            <span class="ue-card-pill">For Agents · $0</span>
                            <div class="ue-card-price">Paste 1 Listing Link</div>
                            <div class="ue-card-suburb">Auto-post free forever with Call, SMS &amp; 24/7 Voice AI enquiries.</div>
                        </div>
                    </a>
                    <a href="/explore?mode=buy" class="ue-glass-card ue-empty-card lg-refract">
                        <div class="ue-card-body">
                            <span class="ue-card-pill">Australian-Owned</span>
                            <div class="ue-card-price">Explore Spatial Map</div>
                            <div class="ue-card-suburb">No login wall. No US ad trackers. Open source (Apache 2.0).</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    @* ─── Re-imagined Phone-Native Buyer Pillars ─── *@
    <section class="ue-section">
        <div class="ue-section-head">
            <span class="ue-eyebrow">Re-imagining Australian Property Sales</span>
            <h2>Built for your phone. Free for everyone.</h2>
            <p>
                A$1.7 billion leaves Australia every year to US-owned listing portals (News Corp's REA and CoStar's Domain).
                unrealestate.au is a <strong>not-for-profit</strong> open-source alternative built by Tailor.
            </p>
        </div>

        <div class="ue-pillars">
            <article class="lg-surface-strong ue-pillar">
                <div class="ue-pillar-icon" aria-hidden="true">🎯</div>
                <h3>Honest buyer matching</h3>
                <p>Tell us your suburbs, budget, and rooms. Every match explains <em>why</em> it fits — missing details stay marked unknown, and paid bumps don't exist.</p>
                <a href="/buyer/matches" class="ue-link">Start your buyer brief →</a>
            </article>

            <article class="lg-surface-strong ue-pillar">
                <div class="ue-pillar-icon" aria-hidden="true">📱</div>
                <h3>True cost &amp; zero-signup shortlist</h3>
                <p>See estimated monthly repayments and state stamp duty right on each home, and heart properties into your phone shortlist without creating an account.</p>
                <a href="/explore?mode=buy" class="ue-link">Explore homes on map →</a>
            </article>

            <article class="lg-surface-strong ue-pillar">
                <div class="ue-pillar-icon" aria-hidden="true">🎙</div>
                <h3>Call, text or 24/7 AI voice</h3>
                <p>Tap to call, text, book an inspection, or ask the property's ElevenLabs voice concierge (via <code>api.sovrgn.ai</code>) — straight to the listing agent.</p>
                <a href="/enquiries" class="ue-link">See enquiry &amp; voice hub →</a>
            </article>
        </div>
    </section>

    @* ─── Agent 1-Link Auto-Post Quick Strip ─── *@
    <section class="ue-section">
        <div class="lg-surface-strong ue-agent-banner">
            <div class="ue-agent-copy">
                <span class="ue-eyebrow">For Australian Real Estate Agents</span>
                <h2>Just give us your listing link. We auto-post it for $0.</h2>
                <p>
                    Stop asking vendors for $4,000 upfront VPA just to test the market. Paste your agency listing URL — we pull the specs,
                    publish free forever, and handle buyer calls, texts &amp; voice AI enquiries.
                </p>
            </div>
            <div class="ue-agent-form">
                <input type="url"
                       class="lg-input"
                       placeholder="https://youragency.com.au/listing/..."
                       @bind="_quickAgentUrl"
                       @bind:event="oninput" />
                <button type="button" class="lg-btn lg-btn-primary" @onclick="GoToAgentImport">
                    Auto-Post Free ($0) →
                </button>
            </div>
        </div>
    </section>

    @* ─── Why we exist: funds flow ─── *@
    <section class="ue-section" id="why-we-exist">
        <div class="lg-surface-strong ue-sankey-card">
            <PhotoTaxSankey />
        </div>
    </section>

    @* ─── Clean Not-for-Profit Footer ─── *@
    <footer class="ue-footer">
        <div class="ue-footer-inner lg-surface-strong">
            <div>
                <strong>unrealestate.au</strong> · Not-for-profit community project by Tailor · Apache 2.0 · Hosted in Australia.
                <div class="ue-footer-sub">No profit margin. No equity. Listings, search &amp; buyer enquiries are free — always.</div>
            </div>
            <div class="ue-footer-links">
                <a href="/buyer/matches">AI Match</a>
                <a href="/explore?mode=buy">Map</a>
                <a href="/agents">For Agents ($0)</a>
                <a href="/enquiries">Enquiries</a>
                <a href="https://github.com/Tailor-AUS/unrealestate.au" target="_blank" rel="noopener">GitHub</a>
            </div>
        </div>
    </footer>
</div>

