@using Aigents.Web.Services
@inject NavigationManager Nav
@inject ISiteContext SiteContext
@inject IJSRuntime JSRuntime

@*
    Hero — agent-SaaS thesis.
    See docs/VISION.md for the eight pillars and the photo-tax tagline this UI implements.
*@

<div class="hero-wrapper" @onmousemove="HandleMouseMove">
    @* Interactive ripple background *@
    <canvas id="ripple-canvas" class="ripple-canvas"></canvas>
    <div class="hero-bg"></div>

    @* Navigation *@
    <nav class="hero-nav">
        <div class="nav-container">
            <div class="logo" @onclick="GoHome">
                <span class="logo-mark">◆</span>
                <span class="logo-text">aigents</span>
            </div>
            <div class="nav-links">
                <a href="#how-it-works" class="nav-link">How It Works</a>
                <a href="/chat?mode=buy" class="nav-link">For Buyers</a>
                <button class="nav-cta" @onclick="GoToAgentRegister">Try Free</button>
            </div>
        </div>
    </nav>

    @* Hero Section - Split Layout *@
    <section class="hero-section">
        <div class="hero-grid">
            @* Left Content *@
            <div class="hero-left animate-fade-up">
                <div class="eyebrow">
                    <span class="eyebrow-icon">◆</span>
                    <span>For Australian Real Estate Agents</span>
                </div>

                <h1 class="hero-headline">
                    Stop paying the<br/>
                    <span class="headline-gradient">photo tax.</span>
                </h1>

                <p class="hero-subheadline">
                    Facebook hosts our photos for free. Instagram hosts our videos for free.
                    So why do agents pay realestate.com.au and Domain $3,000–$4,000 just to list
                    the most valuable thing most Australians will ever sell — their home?
                </p>

                @* Primary + secondary CTAs *@
                <div class="cta-input-group">
                    <div class="input-wrapper">
                        <button class="input-submit" @onclick="GoToAgentRegister">
                            Try free for agents
                            <span class="cta-arrow">→</span>
                        </button>
                        <a href="/chat?mode=buy" class="address-input" style="display:flex;align-items:center;justify-content:center;text-decoration:none;color:inherit;padding:0 20px;">
                            Looking to buy? Talk to our AI
                        </a>
                    </div>
                </div>

                @* Trust Badges *@
                <div class="trust-badges">
                    <div class="trust-badge">
                        <span class="badge-check">✓</span>
                        <span>Australian-owned</span>
                    </div>
                    <div class="trust-badge">
                        <span class="badge-check">✓</span>
                        <span>Open source</span>
                    </div>
                    <div class="trust-badge">
                        <span class="badge-check">✓</span>
                        <span>No per-listing fees</span>
                    </div>
                </div>
            </div>

            @* Right Visual — agent dashboard mockup *@
            <div class="hero-right animate-fade-up delay-2">
                <div class="mockup-container">
                    @* Phone Mockup *@
                    <div class="phone-mockup">
                        <div class="phone-screen">
                            <div class="screen-header">
                                <span class="screen-title">Listing Drafted by AI</span>
                                <span class="screen-status live">● Live</span>
                            </div>
                            <div class="property-card">
                                <img src="images/property-hero.jpg" alt="67 Northview Outlook, Moorooka" class="property-image" />
                                <div class="property-details">
                                    <div class="property-address">67 Northview Outlook, Moorooka QLD 4105</div>
                                    <div class="property-type">Generated by gpt-4o · 0.42¢ in tokens</div>
                                </div>
                            </div>
                            <div class="offers-section">
                                <div class="offers-title">Buyer matches from Aigents AI</div>
                                <div class="offer-item">
                                    <div class="offer-left">
                                        <div class="offer-agent">Sarah K.</div>
                                        <div class="offer-terms">Pre-approved · 4-bed · $1.4M budget</div>
                                    </div>
                                    <div class="offer-right">
                                        <div class="offer-price">98%</div>
                                        <div class="offer-comm">match</div>
                                    </div>
                                </div>
                                <div class="offer-item highlight">
                                    <div class="offer-left">
                                        <div class="offer-agent">Mark D.</div>
                                        <div class="offer-terms">Cash buyer · Wants Moorooka/Yeronga</div>
                                    </div>
                                    <div class="offer-right">
                                        <div class="offer-price">94%</div>
                                        <div class="offer-comm">match</div>
                                    </div>
                                </div>
                                <div class="offer-item">
                                    <div class="offer-left">
                                        <div class="offer-agent">Priya N.</div>
                                        <div class="offer-terms">Renovated 4-bed · 6km radius</div>
                                    </div>
                                    <div class="offer-right">
                                        <div class="offer-price">89%</div>
                                        <div class="offer-comm">match</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Floating Badges *@
                    <div class="floating-badge badge-1">
                        <span class="float-icon">🇦🇺</span>
                        <div class="float-text">
                            <strong>Australia East</strong>
                            <span>All inference local</span>
                        </div>
                    </div>
                    <div class="floating-badge badge-2">
                        <span class="float-icon">⚡</span>
                        <div class="float-text">
                            <strong>$0.42</strong>
                            <span>Total AI cost so far</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* How It Works Section *@
    <section class="how-section" id="how-it-works">
        <div class="how-container">
            <h2 class="how-title">How it works</h2>
            <div class="how-steps">
                <div class="how-step">
                    <div class="step-num">01</div>
                    <h3>Upload your photos</h3>
                    <p>Drop in the photos you've already taken. Our AI writes the listing copy, the suburb pitch, the buyer Q&amp;A, and the valuation in under a minute.</p>
                </div>
                <div class="how-step">
                    <div class="step-num">02</div>
                    <h3>Buyers come to you</h3>
                    <p>Active buyers chatting with the Aigents buyer-side AI get matched to your listing in real time. No realestate.com.au required.</p>
                </div>
                <div class="how-step">
                    <div class="step-num">03</div>
                    <h3>You close the deal</h3>
                    <p>You stay the agent of record. You keep the relationship, you keep the commission. We just bill you for the GPT tokens, plus a flat margin.</p>
                </div>
            </div>
        </div>
    </section>
</div>


@code {
    [Parameter]
    public EventCallback<string> OnGetStarted { get; set; }

    private bool _rippleInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_rippleInitialized)
        {
            _rippleInitialized = true;
            await InitializeRippleEffect();
        }
    }

    private async Task InitializeRippleEffect()
    {
        await JSRuntime.InvokeVoidAsync("propertyViz.initRipple");
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        // Mouse tracking handled by JS
    }

    private void GoHome()
    {
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void GoToAgentRegister()
    {
        Nav.NavigateTo("/agents/register");
    }
}
