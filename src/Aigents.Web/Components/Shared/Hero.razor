@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Aigents.Domain.Entities
@using Aigents.Infrastructure.Services.Import
@using Aigents.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav
@inject IListingService ListingService

<div class="ue-home" data-testid="liquid-glass-home">
    @* ─── Full-Viewport Sunlit Apple Liquid Glass Hero (1:1 Keynote Layout) ─── *@
    <section class="ue-hero">
        <div class="ue-hero-photo" aria-hidden="true"></div>
        <div class="ue-hero-scrim" aria-hidden="true"></div>

        <div class="ue-hero-stage">
            <div class="ue-hero-spacer" aria-hidden="true"></div>

            @* Strictly 2 clean elements in the center: Headline + Clear Frosted Search Capsule *@
            <div class="ue-hero-center">
                <h1 class="ue-hero-title">Australian homes. $0 to list.</h1>

                <div class="ue-search-capsule lg-refract">
                    <input type="text"
                           class="ue-search-input"
                           data-testid="hero-search-input"
                           placeholder="Search Paddington, New Farm, Burleigh..."
                           @bind="_query"
                           @bind:event="oninput"
                           @onkeyup="HandleKeyup" />
                    <button type="button"
                            class="ue-sparkle-btn"
                            data-testid="hero-search-submit"
                            aria-label="Search or AI Match"
                            title="Search or AI Match"
                            @onclick="HandleSearch">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M11 2l2.1 6.3L19.4 10.4 13.1 12.5 11 18.8 8.9 12.5 2.6 10.4 8.9 8.3 11 2zm8 12l1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3z" />
                        </svg>
                    </button>
                </div>
            </div>

            @* Desktop: 3 Luminous Clear Liquid Glass Cards floating over the turquoise pool *@
            <div class="ue-desktop-cards" data-testid="hero-preview-cards">
                @if (_featured.Count > 0)
                {
                    @for (var idx = 0; idx < _featured.Count; idx++)
                    {
                        var l = _featured[idx];
                        var thumb = ResolveCardImage(l, idx);
                        <a href="@($"/property/{l.Id}")" class="ue-glass-card lg-refract">
                            <div class="ue-card-thumb">
                                <img src="@thumb" alt="@l.Address" referrerpolicy="no-referrer" />
                            </div>
                            <div class="ue-card-meta">
                                <span class="ue-sage-pill">Pre-Market · $0 VPA</span>
                                <div class="ue-card-bottom">
                                    <div class="ue-card-price">@FormatPriceShort(l)</div>
                                    <div class="ue-card-suburb">@FormatSuburbLine(l)</div>
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <a href="/buyer/matches" class="ue-glass-card lg-refract">
                        <div class="ue-card-thumb"><img src="/images/hero-queenslander.jpg" alt="Paddington Queenslander" /></div>
                        <div class="ue-card-meta">
                            <span class="ue-sage-pill">Pre-Market · $0 VPA</span>
                            <div class="ue-card-bottom">
                                <div class="ue-card-price">AI Match</div>
                                <div class="ue-card-suburb">Explainable buyer brief</div>
                            </div>
                        </div>
                    </a>
                    <a href="/agents#quick-link-post" class="ue-glass-card lg-refract">
                        <div class="ue-card-thumb"><img src="/images/card-newfarm.jpg" alt="New Farm residence" /></div>
                        <div class="ue-card-meta">
                            <span class="ue-sage-pill">Agents · $0 Forever</span>
                            <div class="ue-card-bottom">
                                <div class="ue-card-price">Paste Link</div>
                                <div class="ue-card-suburb">Auto-post in seconds</div>
                            </div>
                        </div>
                    </a>
                    <a href="/explore?mode=buy" class="ue-glass-card lg-refract">
                        <div class="ue-card-thumb"><img src="/images/card-burleigh.jpg" alt="Burleigh coastal home" /></div>
                        <div class="ue-card-meta">
                            <span class="ue-sage-pill">Not-for-profit · AU</span>
                            <div class="ue-card-bottom">
                                <div class="ue-card-price">Explore Map</div>
                                <div class="ue-card-suburb">Zero US portal tax</div>
                            </div>
                        </div>
                    </a>
                }
            </div>

            @* Phone-Native: Swipeable Single Frosted Glass Bottom Sheet (EXACT iPhone reference) *@
            <div class="ue-phone-sheets" aria-label="Featured homes" data-testid="hero-preview-cards-mobile">
                @if (_featured.Count > 0)
                {
                    @foreach (var item in _featured)
                    {
                        var l = item;
                        <a href="@($"/property/{l.Id}")" class="ue-phone-sheet lg-refract">
                            <div class="ue-sheet-grabber" aria-hidden="true"></div>
                            <div class="ue-sheet-title">@l.Address, @l.Suburb</div>
                            <div class="ue-sheet-row">
                                <span>@FormatPhoneSpecs(l)</span>
                                <span class="ue-sheet-pill">@FormatPriceShort(l) · $0 VPA</span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <a href="/buyer/matches" class="ue-phone-sheet lg-refract">
                        <div class="ue-sheet-grabber" aria-hidden="true"></div>
                        <div class="ue-sheet-title">Find homes that fit your brief</div>
                        <div class="ue-sheet-row">
                            <span>Australian-owned · Not-for-profit</span>
                            <span class="ue-sheet-pill">AI Match</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>

    @* ─── Below-the-fold: Clean Airy Apple Sections ─── *@
    <section class="ue-section">
        <div class="ue-section-head">
            <span class="ue-eyebrow">Not-for-profit · Open Source · Australian-Owned</span>
            <h2>Built for your phone. Free forever.</h2>
            <p>
                A$1.7 billion leaves Australia every year to US-owned portals (News Corp's REA and CoStar's Domain).
                unrealestate.au is the free Australian alternative — listings, search, and buyer enquiries cost $0, always.
            </p>
        </div>

        <div class="ue-pillars">
            <article class="lg-surface-strong ue-pillar">
                <h3>Explainable buyer matching</h3>
                <p>Tell us your suburbs, budget, and rooms. Every match shows exactly why it scored — missing facts stay marked unknown, and paid bumps don't exist.</p>
                <a href="/buyer/matches" class="ue-link">Open buyer brief →</a>
            </article>

            <article class="lg-surface-strong ue-pillar">
                <h3>True monthly cost &amp; shortlist</h3>
                <p>Check estimated repayments and state transfer duty right on every listing, and heart homes privately on your phone with zero signup.</p>
                <a href="/explore?mode=buy" class="ue-link">Explore spatial map →</a>
            </article>

            <article class="lg-surface-strong ue-pillar">
                <h3>1-link auto-post &amp; instant enquiries</h3>
                <p>Agents paste their listing link once to publish for $0, then handle buyer calls, texts, and opt-in 24/7 ElevenLabs voice enquiries via <code>api.sovrgn.ai</code>.</p>
                <a href="/agents#quick-link-post" class="ue-link">Paste a listing link →</a>
            </article>
        </div>
    </section>

    <section class="ue-section">
        <div class="lg-surface-strong ue-agent-banner">
            <div>
                <span class="ue-eyebrow">For Australian Real Estate Agents</span>
                <h2>Just give us your listing link. We auto-post it for $0.</h2>
                <p>Stop asking vendors for $4,000 upfront VPA just to test the market. Keep your commission intact.</p>
            </div>
            <div class="ue-agent-form">
                <input type="url"
                       class="lg-input"
                       placeholder="https://youragency.com.au/listing/..."
                       @bind="_quickAgentUrl"
                       @bind:event="oninput" />
                <button type="button" class="lg-btn lg-btn-primary" @onclick="GoToAgentImport">
                    Continue to Auto-Post ($0) →
                </button>
            </div>
        </div>
    </section>

    <section class="ue-section" id="why-we-exist">
        <div class="lg-surface-strong ue-sankey-card">
            <PhotoTaxSankey />
        </div>
    </section>

    <footer class="ue-footer">
        <div class="ue-footer-inner lg-surface-strong">
            <div>
                <strong>unrealestate.au</strong> · Not-for-profit by Tailor · Apache 2.0 · Hosted in Australia.
                <div class="ue-footer-sub">No profit margin. No equity. Listings, search &amp; buyer enquiries are free — always.</div>
            </div>
            <div class="ue-footer-links">
                <a href="/buyer/matches">Pre-Market &amp; Match</a>
                <a href="/explore?mode=buy">Map</a>
                <a href="/agents">Agents ($0)</a>
                <a href="/enquiries">Enquiries</a>
                <a href="https://github.com/Tailor-AUS/unrealestate.au" target="_blank" rel="noopener">GitHub</a>
            </div>
        </div>
    </footer>
</div>

<style>
