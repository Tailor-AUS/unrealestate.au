@code {
    [Parameter]
    public EventCallback<string> OnGetStarted { get; set; }

    private string _searchType = "buy";
    private string _searchQuery = "";
    private string _audience = "sellers";

    protected override void OnInitialized()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        switch (path)
        {
            case "/sell":
                _audience = "sellers";
                _searchType = "address";
                break;
            case "/buy":
                _audience = "buyers";
                _searchType = "buy";
                break;
            case "/rent":
                _audience = "buyers";
                _searchType = "rent";
                break;
            case "/agent":
            case "/agents":
                _audience = "agents";
                _searchType = "agents";
                break;
        }
    }

    // Demo image pairs for the AI staging slider on the homepage.
    // Swap these URLs for real before/after photos once the AI staging pipeline ships.
    private readonly List<BeforeAfterSlider.SliderItem> _stagingDemo = new()
    {
        new BeforeAfterSlider.SliderItem(
            "Outdoor living",
            "https://picsum.photos/seed/ue-outdoor-before/1400/900",
            "https://picsum.photos/seed/ue-outdoor-after/1400/900",
            Icon: "🌿"),
        new BeforeAfterSlider.SliderItem(
            "Lounge",
            "https://picsum.photos/seed/ue-lounge-before/1400/900",
            "https://picsum.photos/seed/ue-lounge-after/1400/900",
            Icon: "🛋️"),
        new BeforeAfterSlider.SliderItem(
            "Kitchen",
            "https://picsum.photos/seed/ue-kitchen-before/1400/900",
            "https://picsum.photos/seed/ue-kitchen-after/1400/900",
            Icon: "🍳"),
        new BeforeAfterSlider.SliderItem(
            "Bedroom",
            "https://picsum.photos/seed/ue-bedroom-before/1400/900",
            "https://picsum.photos/seed/ue-bedroom-after/1400/900",
            Icon: "🛏️")
    };

    private string GetHeroTitle() => _searchType switch
    {
        "buy" => "Search Australian properties for sale",
        "rent" => "Search Australian rentals",
        "sold" => "Browse recently sold Australian properties",
        "address" => "Look up any Australian address",
        "agents" => "Find an Australian agent",
        "ai" => "Talk to your AI buyer agent",
        _ => "Search Australian properties"
    };

    private string GetPlaceholder() => _searchType switch
    {
        "buy" => "Search suburb, postcode or state",
        "rent" => "Search rental suburb, postcode or state",
        "sold" => "Search sold properties by suburb",
        "address" => "Enter a full address (e.g. 67 Northview Outlook, Moorooka)",
        "agents" => "Find an Australian agent by suburb or name",
        "ai" => "Tell the AI what you're looking for…",
        _ => "Search"
    };

    private void SetSearch(string type)
    {
        _searchType = type;
    }

    private void HandleKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSearch();
        }
    }

    private void HandleSearch()
    {
        var q = Uri.EscapeDataString(_searchQuery ?? "");
        var url = _searchType switch
        {
            "ai" => $"/chat?mode=buy&q={q}",
            "agents" => $"/agents?q={q}",
            "address" => $"/explore?type=address&q={q}",
            _ => $"/explore?type={_searchType}&q={q}"
        };
        Nav.NavigateTo(url);
    }

    private void GoHome()
    {
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void GoToAgentRegister()
    {
        Nav.NavigateTo("/agents/register");
    }
}
