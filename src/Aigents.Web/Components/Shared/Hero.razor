@using Aigents.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav
@inject ISiteContext SiteContext
@inject IJSRuntime JSRuntime

@*
    Aigents homepage — REA-style utility hero (search first), but
    Australian-owned, not-for-profit, free, open source. Three audiences
    on the same page: Sellers, Agents, Buyers. Stats band sits between
    the search hero and the audience tabs to hammer the "why we exist"
    message without burying the utility.
*@

<div class="rea-page">
    @* ─── Top nav ─── *@
    <nav class="rea-nav">
        <div class="rea-nav-inner">
            <a href="/" class="rea-logo" @onclick:preventDefault @onclick="GoHome">
                <span class="logo-mark">◆</span>
                <span class="logo-text">unreal<span class="logo-au">.estate</span></span>
                <span class="logo-pill">not-for-profit</span>
            </a>
            <div class="rea-nav-links">
                <a href="/explore?type=buy" class="rea-nav-link">Buy</a>
                <a href="/explore?type=rent" class="rea-nav-link">Rent</a>
                <a href="/explore?type=sold" class="rea-nav-link">Sold</a>
                <a href="/agents" class="rea-nav-link">Find agents</a>
                <a href="#why-we-exist" class="rea-nav-link">Why we exist</a>
                <a href="https://github.com/Tailor-AUS/aigents-dotnet" target="_blank" rel="noopener" class="rea-nav-link">GitHub</a>
            </div>
            <div class="rea-nav-actions">
                <a href="/agents/register" class="rea-btn-secondary">Sign in</a>
                <button class="rea-btn-primary" @onclick="GoToAgentRegister">Use it free</button>
            </div>
        </div>
    </nav>

    @* ─── Search hero ─── *@
    <section class="rea-hero">
        <div class="rea-hero-bg"></div>
        <div class="rea-hero-content">
            <h1 class="rea-hero-title">@GetHeroTitle()</h1>

            <div class="rea-search-card">
                <div class="rea-tabs">
                    <button class="rea-tab @(_searchType == "buy" ? "active" : "")" @onclick="@(() => SetSearch("buy"))" type="button">Buy</button>
                    <button class="rea-tab @(_searchType == "rent" ? "active" : "")" @onclick="@(() => SetSearch("rent"))" type="button">Rent</button>
                    <button class="rea-tab @(_searchType == "sold" ? "active" : "")" @onclick="@(() => SetSearch("sold"))" type="button">Sold</button>
                    <button class="rea-tab @(_searchType == "address" ? "active" : "")" @onclick="@(() => SetSearch("address"))" type="button">Address</button>
                    <button class="rea-tab @(_searchType == "agents" ? "active" : "")" @onclick="@(() => SetSearch("agents"))" type="button">Agents</button>
                    <button class="rea-tab rea-tab-ai @(_searchType == "ai" ? "active" : "")" @onclick="@(() => SetSearch("ai"))" type="button">✨ Ask AI</button>
                </div>
                <div class="rea-search-row">
                    <span class="rea-search-icon">🔍</span>
                    <input type="text"
                           class="rea-search-input"
                           placeholder="@GetPlaceholder()"
                           @bind="_searchQuery"
                           @bind:event="oninput"
                           @onkeyup="HandleKeyup" />
                    <button class="rea-search-filters" type="button" disabled>≡ Filters</button>
                    <button class="rea-search-submit" @onclick="HandleSearch" type="button">Search</button>
                </div>
            </div>

            @* Trust strip — woven Aussie / non-profit values *@
            <div class="rea-trust-strip">
                <span class="rea-trust-item">🇦🇺 Australian-owned · operated by Tailor</span>
                <span class="rea-trust-item">💚 Not-for-profit · no margin, no equity</span>
                <span class="rea-trust-item">📖 Open source · Apache 2.0</span>
                <span class="rea-trust-item">🏠 Hosted in Australia · data stays here</span>
            </div>
        </div>
    </section>

    @* ─── Stats band — the photo tax in numbers ─── *@
    <section class="stats-band" id="why-we-exist">
        <div class="stats-container">
            <div class="stats-eyebrow">Why we exist</div>
            <h2 class="stats-headline">A$1.7 billion leaves Australia every year just to advertise Australian homes — to two American companies.</h2>
            <div class="stats-grid">
                <div class="stat-cell">
                    <div class="stat-figure">A$1.7B</div>
                    <div class="stat-label">Leaves Australia every year. Aussies paying foreign portals to advertise Australian homes.</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-figure">100%</div>
                    <div class="stat-label">Of major Australian listing portals are now US-owned (News Corp + CoStar Group).</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-figure">531,457</div>
                    <div class="stat-label">Australian families paid the foreign tax in FY2024-25 to sell their largest asset.</div>
                </div>
                <div class="stat-cell">
                    <div class="stat-figure">0</div>
                    <div class="stat-label">Australian-owned major listing portals as of 27 August 2025.</div>
                </div>
            </div>
            <p class="stats-footnote">
                Sources:
                <a href="https://companiesmarketcap.com/rea-group/revenue/" target="_blank" rel="noopener">REA FY2025 revenue</a> ·
                <a href="https://www.costargroup.com/press-room/2025/costar-group-completes-acquisition-domain-ushering-new-era-innovation-australias" target="_blank" rel="noopener">CoStar acquisition</a> ·
                <a href="https://pages.corelogic.com/hubfs/CoreLogic%20AU/Article%20Reports/2507-Cotality-HousingChartPack-July-Report.pdf" target="_blank" rel="noopener">Cotality FY24-25 sales</a>
            </p>
        </div>
    </section>

    @* ─── AI staging demo: before/after drag slider for sellers ─── *@
    <section class="ai-staging-band" id="ai-staging">
        <div class="ai-staging-container">
            <div class="ai-staging-eyebrow">Free AI for sellers</div>
            <h2 class="ai-staging-headline">Your phone snaps, restyled into pro listing photos</h2>
            <p class="ai-staging-sub">
                Snap on your phone. Drop them in. Our AI gives you the kind of marketing photos
                agencies charge $300+ per room for — free, in seconds. Drag the slider to compare.
            </p>

            <div class="ai-staging-slider">
                <BeforeAfterSlider Items="_stagingDemo"
                                   BeforeLabel="Phone snap"
                                   AfterLabel="AI-staged ✨"
                                   Caption="Demo placeholders — your real photos appear here once you upload them in /list." />
            </div>

            <div class="ai-staging-cta">
                <a class="rea-btn-primary ai-staging-primary" href="/list">List your home free →</a>
                <a class="ai-staging-secondary" href="/chat?mode=sell">See how it works</a>
            </div>
        </div>
    </section>

    @* ─── Audience tabs section: Built for Australians ─── *@
    <section class="audience-section">
        <div class="audience-container">
            <h2 class="audience-title">Built for Australians, by Australians</h2>
            <p class="audience-subtitle">unreal.estate serves all three sides of the housing market — for free. No subscriptions. No upsells. No offshore middlemen. We're a not-for-profit community project by <strong>Tailor</strong> — the team behind the open Australian fuel-price app already used by 50,000+ Aussies.</p>

            <div class="audience-tabs">
                <button class="audience-tab @(_audience == "sellers" ? "active" : "")" @onclick="@(() => _audience = "sellers")" type="button">Sellers</button>
                <button class="audience-tab @(_audience == "agents" ? "active" : "")" @onclick="@(() => _audience = "agents")" type="button">Agents</button>
                <button class="audience-tab @(_audience == "buyers" ? "active" : "")" @onclick="@(() => _audience = "buyers")" type="button">Buyers</button>
            </div>

            <div class="audience-cards">
                @if (_audience == "sellers")
                {
                    <div class="audience-card">
                        <div class="audience-card-icon">📝</div>
                        <h3>List your home for $0</h3>
                        <p>Upload your photos, enter your address. Our AI writes the listing copy in under a minute. No marketing tax, no Premiere upsell, no $3,000 cheque to a US company.</p>
                        <a class="audience-card-cta" href="/list">Start a free listing →</a>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-icon">📊</div>
                        <h3>Get an instant AI valuation</h3>
                        <p>Comparable sales analysis from Australian data. Know what your home is worth before you sign anything — no agent appointment required.</p>
                        <a class="audience-card-cta" href="/chat?mode=sell">Ask the AI →</a>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-icon">🤝</div>
                        <h3>Sell direct or pick an agent</h3>
                        <p>List on unreal.estate and let buyers come to you. Tag it as an OPEN listing and any agent in your area can sell it — whoever brings the buyer earns the commission, and you stay in control.</p>
                        <a class="audience-card-cta" href="/agents">Find an agent →</a>
                    </div>
                }
                else if (_audience == "agents")
                {
                    <div class="audience-card">
                        <div class="audience-card-icon">🚪</div>
                        <h3>Migrate off REA / Domain in one click</h3>
                        <p>You own your photos. You own your listing copy. We just help you move them. Cancel REA Premiere. Save thousands per listing. No lock-in.</p>
                        <a class="audience-card-cta" href="/agents/register">Try unreal.estate free →</a>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-icon">⚡</div>
                        <h3>Free AI listing tools</h3>
                        <p>Listing copy, valuation, buyer Q&amp;A, offer analysis — all generated by AI in seconds. You pay only the literal token cost (no margin), itemised to the cent.</p>
                        <a class="audience-card-cta" href="/agents#how-it-works">See how it works →</a>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-icon">🎯</div>
                        <h3>Live buyer demand</h3>
                        <p>Buyers chatting with the unreal.estate AI get matched to your listings in real time. No competing for clicks on a foreign-owned portal.</p>
                        <a class="audience-card-cta" href="/agents">Read more →</a>
                    </div>
                }
                else
                {
                    <div class="audience-card">
                        <div class="audience-card-icon">✨</div>
                        <h3>Talk to our AI buyer agent</h3>
                        <p>Tell the AI what you're looking for in plain English. Budget, suburbs, school zones, dealbreakers. It searches Australian listings and pings you when a real match appears.</p>
                        <a class="audience-card-cta" href="/chat?mode=buy">Start chatting →</a>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-icon">🗺️</div>
                        <h3>Browse Australian listings</h3>
                        <p>On-market, off-market, and migrated-from-REA. Filter by suburb, postcode, budget, beds. No login. No ads. No US tracking pixels.</p>
                        <a class="audience-card-cta" href="/explore?type=buy">Browse listings →</a>
                    </div>
                    <div class="audience-card">
                        <div class="audience-card-icon">🏘️</div>
                        <h3>Get suburb intel</h3>
                        <p>Free suburb reports — schools, crime, growth, demographics. Built on open Australian government data, not paywalled comparables.</p>
                        <a class="audience-card-cta" href="/explore?type=suburbs">Explore suburbs →</a>
                    </div>
                }
            </div>
        </div>
    </section>

    @* ─── Footer (Aussie-ownership statement, REA-mirror) ─── *@
    <footer class="rea-footer">
        <div class="rea-footer-inner">
            <div class="rea-footer-brand">
                <div class="rea-logo">
                    <span class="logo-mark">◆</span>
                    <span class="logo-text">unreal<span class="logo-au">.estate</span></span>
                </div>
                <p class="rea-footer-statement">
                    unrealestate.au is owned and operated by <strong>Tailor</strong> — a not-for-profit
                    community project run by the same team behind the open Australian fuel-price
                    app used by 50,000+ Aussies. Built on the open-source <em>Aigents</em> platform —
                    source code Apache 2.0 on
                    <a href="https://github.com/Tailor-AUS/aigents-dotnet" target="_blank" rel="noopener">GitHub</a>.
                    Hosted in Australia East. We charge no margin and hold no equity.
                </p>
            </div>
            <div class="rea-footer-col">
                <h4>unreal.estate</h4>
                <a href="/list">List your home</a>
                <a href="/agents/register">For agents</a>
                <a href="/explore?type=buy">Browse listings</a>
                <a href="/chat?mode=buy">AI buyer agent</a>
            </div>
            <div class="rea-footer-col">
                <h4>Why we exist</h4>
                <a href="#why-we-exist">The A$1.7B drain</a>
                <a href="https://github.com/Tailor-AUS/aigents-dotnet/blob/main/docs/VISION.md" target="_blank" rel="noopener">Read the thesis</a>
                <a href="https://github.com/Tailor-AUS/aigents-dotnet/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Contribute</a>
            </div>
            <div class="rea-footer-col">
                <h4>Australian by design</h4>
                <a href="https://github.com/Tailor-AUS/aigents-dotnet" target="_blank" rel="noopener">Open source</a>
                <a href="https://github.com/TailorAU/pact" target="_blank" rel="noopener">Built on PACT</a>
                <a href="#">Tailor (parent org)</a>
            </div>
        </div>
        <div class="rea-footer-bottom">
            <p>© @DateTime.Now.Year unreal.estate · Apache License 2.0 · Built in Australia, hosted in Australia, governed by Australian law</p>
        </div>
    </footer>
</div>


<style>
    /* ═══════════════════════════════════════════════════════════════
       AIGENTS HOMEPAGE — REA-style utility, Aussie non-profit ethos
    ═══════════════════════════════════════════════════════════════ */

    .rea-page {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        color: #1a1a2e;
        background: white;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    /* ─── Nav ─── */
    .rea-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }
    .rea-nav-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 14px 24px;
        display: flex;
        align-items: center;
        gap: 32px;
    }
    .rea-logo {
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
    }
    .rea-logo .logo-mark { font-size: 20px; color: #6366f1; }
    .rea-logo .logo-text { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
    .rea-logo .logo-au { color: #6366f1; }
    .rea-logo .logo-pill {
        margin-left: 10px;
        padding: 3px 8px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #047857;
        background: #d1fae5;
        border-radius: 4px;
    }
    .rea-nav-links {
        display: flex;
        gap: 24px;
        flex: 1;
        margin-left: 8px;
    }
    .rea-nav-link {
        font-size: 14px;
        font-weight: 600;
        color: #1a1a2e;
        text-decoration: none;
        padding: 6px 2px;
        border-bottom: 2px solid transparent;
        transition: border-color 0.15s;
    }
    .rea-nav-link:hover { border-bottom-color: #6366f1; }
    .rea-nav-actions { display: flex; gap: 12px; align-items: center; }
    .rea-btn-secondary {
        font-size: 14px;
        font-weight: 600;
        color: #1a1a2e;
        text-decoration: none;
        padding: 8px 14px;
    }
    .rea-btn-primary {
        font-size: 14px;
        font-weight: 700;
        color: white;
        background: #ef4444;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        cursor: pointer;
        transition: background 0.15s, transform 0.1s;
    }
    .rea-btn-primary:hover { background: #dc2626; }
    .rea-btn-primary:active { transform: translateY(1px); }

    /* ─── Hero (search-first) ─── */
    .rea-hero {
        position: relative;
        min-height: 480px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
        overflow: hidden;
    }
    .rea-hero-bg {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.45) 100%),
            url('https://images.unsplash.com/photo-1568322445389-f64ac2515099?w=1600&q=80') center/cover no-repeat;
        z-index: 0;
    }
    .rea-hero-content {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 880px;
        width: 100%;
    }
    .rea-hero-title {
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 800;
        color: white;
        margin: 0 0 32px 0;
        text-shadow: 0 2px 12px rgba(0,0,0,0.35);
        letter-spacing: -0.02em;
    }
    .rea-search-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.18);
        overflow: hidden;
        text-align: left;
    }
    .rea-tabs {
        display: flex;
        border-bottom: 1px solid rgba(0,0,0,0.08);
        background: #fafafa;
        overflow-x: auto;
    }
    .rea-tab {
        flex: 1;
        min-width: max-content;
        background: none;
        border: none;
        padding: 14px 20px;
        font-size: 14px;
        font-weight: 600;
        color: #6b7280;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        transition: color 0.15s, border-color 0.15s, background 0.15s;
        white-space: nowrap;
    }
    .rea-tab:hover { color: #1a1a2e; background: #f3f4f6; }
    .rea-tab.active {
        color: #ef4444;
        border-bottom-color: #ef4444;
        background: white;
    }
    .rea-tab-ai.active {
        color: #6366f1;
        border-bottom-color: #6366f1;
    }
    .rea-search-row {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        gap: 8px;
    }
    .rea-search-icon {
        font-size: 18px;
        margin-left: 4px;
    }
    .rea-search-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 14px 12px;
        font-size: 15px;
        font-family: inherit;
        background: transparent;
    }
    .rea-search-filters {
        background: white;
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
        cursor: pointer;
    }
    .rea-search-filters:disabled { opacity: 0.5; cursor: not-allowed; }
    .rea-search-submit {
        background: #ef4444;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 24px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s;
    }
    .rea-search-submit:hover { background: #dc2626; }

    .rea-trust-strip {
        margin-top: 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: center;
    }
    .rea-trust-item {
        font-size: 13px;
        font-weight: 600;
        color: white;
        background: rgba(0,0,0,0.35);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.18);
    }

    /* ─── Stats band ─── */
    .stats-band {
        padding: 80px 24px;
        background: linear-gradient(180deg, #0b0b1a 0%, #1a1a2e 100%);
        color: white;
        position: relative;
        z-index: 2;
    }
    .stats-container {
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
    }
    .stats-eyebrow {
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #a78bfa;
        margin-bottom: 16px;
    }
    .stats-headline {
        font-size: clamp(20px, 2.6vw, 30px);
        font-weight: 700;
        line-height: 1.3;
        max-width: 880px;
        margin: 0 auto 40px auto;
        color: white;
        letter-spacing: -0.01em;
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 40px;
        margin-bottom: 40px;
    }
    .stat-cell { text-align: center; }
    .stat-figure {
        font-size: clamp(36px, 5vw, 56px);
        font-weight: 800;
        line-height: 1.1;
        background: linear-gradient(135deg, #a78bfa 0%, #818cf8 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 14px;
        letter-spacing: -0.02em;
    }
    .stat-label {
        font-size: 14px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.72);
        max-width: 240px;
        margin: 0 auto;
    }
    .stats-footnote {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.42);
        margin-top: 32px;
        line-height: 1.6;
    }
    .stats-footnote a {
        color: rgba(255, 255, 255, 0.62);
        text-decoration: none;
        border-bottom: 1px dotted rgba(255, 255, 255, 0.28);
    }
    .stats-footnote a:hover { color: white; }

    /* ─── AI staging band ─── */
    .ai-staging-band {
        padding: 80px 24px;
        background: linear-gradient(180deg, #f5f3ff 0%, #ffffff 100%);
        position: relative;
        z-index: 2;
    }
    .ai-staging-container {
        max-width: 980px;
        margin: 0 auto;
        text-align: center;
    }
    .ai-staging-eyebrow {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #6366f1;
        margin-bottom: 14px;
    }
    .ai-staging-headline {
        font-size: clamp(26px, 3.4vw, 38px);
        font-weight: 800;
        margin: 0 0 14px 0;
        letter-spacing: -0.02em;
        color: #1a1a2e;
    }
    .ai-staging-sub {
        font-size: 16px;
        line-height: 1.6;
        color: #4b5563;
        max-width: 680px;
        margin: 0 auto 32px auto;
    }
    .ai-staging-slider { margin-bottom: 28px; }
    .ai-staging-cta {
        display: flex;
        gap: 16px;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
    }
    .ai-staging-primary {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        padding: 14px 28px;
        font-size: 15px;
    }
    .ai-staging-secondary {
        font-size: 14px;
        font-weight: 700;
        color: #6366f1;
        text-decoration: none;
        padding: 12px 8px;
    }
    .ai-staging-secondary:hover { color: #4f46e5; }

    /* ─── Audience section ─── */
    .audience-section {
        padding: 80px 24px;
        background: #fafafa;
    }
    .audience-container {
