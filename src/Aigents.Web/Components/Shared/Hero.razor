@code {
    [Parameter]
    public EventCallback<string> OnGetStarted { get; set; }

    private static readonly string[] DefaultCardPhotos =
    [
        "/images/hero-queenslander.jpg",
        "/images/card-newfarm.jpg",
        "/images/card-burleigh.jpg"
    ];

    private string _query = "";
    private string _quickAgentUrl = "";
    private List<Listing> _featured = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Prefer listings with an explicit asking price first, then estimates, then deterministic newest
            var published = await ListingService.GetPublishedListingsAsync(12);
            _featured = published
                .OrderByDescending(l => l.AskingPrice.HasValue)
                .ThenByDescending(l => l.EstimatedValue.HasValue)
                .ThenByDescending(l => l.PublishedAt ?? l.CreatedAt)
                .ThenBy(l => l.Id)
                .Take(3)
                .ToList();
        }
        catch
        {
            _featured = [];
        }
    }

    private void HandleKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            HandleSearch();
    }

    private void HandleSearch()
    {
        var q = _query.Trim();

        if (q.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || q.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo($"/agents?link={Uri.EscapeDataString(q)}#quick-link-post");
            return;
        }

        var qs = BuildBriefQuery(q);
        Nav.NavigateTo(string.IsNullOrEmpty(qs) ? "/buyer/matches" : $"/buyer/matches?{qs}");
    }

    private void GoToAgentImport()
    {
        var q = _quickAgentUrl.Trim();
        Nav.NavigateTo(string.IsNullOrEmpty(q)
            ? "/agents#quick-link-post"
            : $"/agents?link={Uri.EscapeDataString(q)}#quick-link-post");
    }

    private static string BuildBriefQuery(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";

        var parts = new List<string>();
        var working = raw;

        var bedMatch = Regex.Match(working, @"\b(\d)\s*\+?\s*bed(?:room)?s?\b", RegexOptions.IgnoreCase);
        if (bedMatch.Success)
        {
            parts.Add($"beds={bedMatch.Groups[1].Value}");
            working = working.Remove(bedMatch.Index, bedMatch.Length);
        }

        var maxMill = Regex.Match(working, @"(?:under|max|<|up to)\s*\$?(\d+(?:\.\d+)?)\s*m\b", RegexOptions.IgnoreCase);
        if (maxMill.Success
            && decimal.TryParse(maxMill.Groups[1].Value, NumberStyles.Number, CultureInfo.InvariantCulture, out var m)
            && m > 0m && m <= 100m)
        {
            parts.Add($"maxPrice={(long)Math.Round(m * 1_000_000m)}");
            working = working.Remove(maxMill.Index, maxMill.Length);
        }
        else
        {
            var maxK = Regex.Match(working, @"(?:under|max|<|up to)?\s*\$(\d{3,4})\s*k\b", RegexOptions.IgnoreCase);
            if (maxK.Success
                && decimal.TryParse(maxK.Groups[1].Value, NumberStyles.Number, CultureInfo.InvariantCulture, out var k)
                && k >= 100m && k <= 9999m)
            {
                parts.Add($"maxPrice={(long)Math.Round(k * 1_000m)}");
                working = working.Remove(maxK.Index, maxK.Length);
            }
            else
            {
                var maxDollars = Regex.Match(working, @"(?:under|max|<|up to)?\s*\$([1-9]\d{2}(?:,\d{3})+|\d{6,8})\b", RegexOptions.IgnoreCase);
                if (maxDollars.Success
                    && decimal.TryParse(maxDollars.Groups[1].Value.Replace(",", ""), NumberStyles.Number, CultureInfo.InvariantCulture, out var d)
                    && d >= 100_000m && d <= 100_000_000m)
                {
                    parts.Add($"maxPrice={(long)Math.Round(d)}");
                    working = working.Remove(maxDollars.Index, maxDollars.Length);
                }
            }
        }

        var cleanSuburbs = Regex.Replace(working, @"\b(house|houses|unit|units|apartment|townhouse|in|near|under|for|sale)\b", " ", RegexOptions.IgnoreCase);
        cleanSuburbs = Regex.Replace(cleanSuburbs, @"\s+", " ").Trim(' ', ',');
        if (!string.IsNullOrWhiteSpace(cleanSuburbs))
            parts.Add($"suburbs={Uri.EscapeDataString(cleanSuburbs)}");

        if (Regex.IsMatch(raw, @"\bhouse(?:s)?\b", RegexOptions.IgnoreCase))
            parts.Add("type=House");
        else if (Regex.IsMatch(raw, @"\b(?:unit|apartment)s?\b", RegexOptions.IgnoreCase))
            parts.Add("type=Unit");
        else if (Regex.IsMatch(raw, @"\btownhouse(?:s)?\b", RegexOptions.IgnoreCase))
            parts.Add("type=Townhouse");

        return string.Join("&", parts);
    }

    private static string ResolveCardImage(Listing l, int slotIndex)
    {
        if (!string.IsNullOrWhiteSpace(l.ImageUrls) && l.ImageUrls.StartsWith('['))
        {
            try
            {
                var urls = JsonSerializer.Deserialize<string[]>(l.ImageUrls);
                var first = urls?.Select(u =>
                {
                    if (string.IsNullOrWhiteSpace(u)) return null;
                    var t = u.Trim();
                    if (t.StartsWith('/')
                        && !t.StartsWith("//", StringComparison.Ordinal)
                        && !t.StartsWith("/\\", StringComparison.Ordinal)) return t;
                    return ListingLinkImporter.SanitizeImageUrl(t, new Uri("https://unrealestate.au/"));
                }).FirstOrDefault(u => u is not null);
                if (!string.IsNullOrWhiteSpace(first)) return first;
            }
            catch { }
        }
        return DefaultCardPhotos[slotIndex % DefaultCardPhotos.Length];
    }

    private static string FormatPriceShort(Listing l)
    {
        if (!string.IsNullOrWhiteSpace(l.PriceDisplay)) return l.PriceDisplay;
        if (l.AskingPrice is decimal a && a > 0)
            return a >= 1_000_000m ? $"${a / 1_000_000m:0.##}M" : $"${a / 1_000m:0}k";
        if (l.EstimatedValue is decimal e && e > 0)
            return e >= 1_000_000m ? $"~${e / 1_000_000m:0.##}M (est.)" : $"~${e / 1_000m:0}k (est.)";
        return "Contact Agent";
    }

    private static string FormatSuburbLine(Listing l)
    {
        var state = string.IsNullOrWhiteSpace(l.State) ? "QLD" : l.State.Trim();
        return $"{l.Suburb} {state}";
    }

    private static string FormatPhoneSpecs(Listing l)
    {
        var parts = new List<string>();
        if (l.Bedrooms.HasValue) parts.Add($"{l.Bedrooms} bed");
        if (l.Bathrooms.HasValue) parts.Add($"{l.Bathrooms} bath");
        if (l.CarSpaces.HasValue) parts.Add($"{l.CarSpaces} car");
        return parts.Count > 0 ? string.Join(" · ", parts) : l.PropertyType;
    }
}
